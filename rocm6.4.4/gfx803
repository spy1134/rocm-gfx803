#!/bin/bash
# gfx803: LoRA training and the ComfyUI server on this machine's gfx803 card,
# managed from one terminal UI.
#
#   ./gfx803              start the service if needed and open the UI
#   ./gfx803 --headless   stop the desktop first (from a text console), for more VRAM
#   ./gfx803 --stop       shut the service down (training resumes on the next start)
#   ./gfx803 --logs       follow the service's log
#   ./gfx803 --shell      a shell in the running container
#
# The service (gfx803-service) runs in a long-lived container named gfx803 and
# does the work: the training queue and ComfyUI, one GPU user at a time. The UI
# (gfx803-app) attaches with docker exec; quitting it stops nothing, and running
# ./gfx803 again from any terminal (a text console, SSH) reattaches.
#
# The container uses the host's network and process namespaces, so the UI's
# system view shows host-wide network traffic and processes. ComfyUI listens on
# this machine's loopback address unless GFX803_COMFYUI_LISTEN names another
# (0.0.0.0 makes it reachable from the LAN on port 8188).
#
# --headless exists because the desktop shares the GPU: on an 8 GB card, SD1.5
# LoRA training needs about 6.6 GB under PyTorch plus about 1 GB of runtime
# overhead, and a desktop holds 300-700 MiB of framebuffers on top.
#
# GFX803_PIN_MCLK=1 with --headless also pins the card's memory clock at its
# top state, until reboot or `echo auto | sudo tee .../power_dpm_force_performance_level`.
# Under automatic power management Polaris switches the memory clock whenever
# GPU load starts or stops, and with more than one monitor attached the switch
# cannot be hidden in a vertical blank, so the screens flicker. Under load the
# memory runs at the top state anyway; pinning only keeps it there at idle,
# for 10-20 W more idle power.
set -euo pipefail

LINE_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
IMAGE=${GFX803_IMAGE:-rocm-gfx803-comfyui:latest}
NAME=gfx803
# Long enough for the service to interrupt a training job (the wrapper waits
# up to 20 s for its process group) and stop ComfyUI (20 s).
STOP_TIMEOUT=90

die() { echo "gfx803: $*" >&2; exit 1; }
running() { [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = true ]; }

case "${1:-}" in
  --stop)
    running || { echo "gfx803: not running"; exit 0; }
    echo "Stopping the gfx803 service (a training job resumes from its last checkpoint next time)..."
    docker stop -t "$STOP_TIMEOUT" "$NAME" >/dev/null
    exit 0 ;;
  --logs) exec docker logs -f "$NAME" ;;
  --shell) running || die "not running"; exec docker exec -it -e TERM -e COLORTERM "$NAME" bash ;;
  --headless|"") ;;
  -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) die "unknown option: $1 (see --help)" ;;
esac

if [ "${1:-}" = --headless ]; then
  [ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ] \
    || die "this terminal belongs to the desktop and would close with it; log in on a text console (Ctrl+Alt+F2) and run ./gfx803 --headless there"
  if systemctl is-active -q display-manager; then
    echo "Stopping the desktop (display-manager); start it again later with: sudo systemctl start display-manager"
    sudo systemctl stop display-manager
  fi
  if [ "${GFX803_PIN_MCLK:-0}" = 1 ]; then
    dev=""
    for d in /sys/class/drm/card*/device; do
      [ "$(cat "$d/vendor" 2>/dev/null)" = 0x1002 ] && [ -f "$d/pp_dpm_mclk" ] && { dev=$d; break; }
    done
    if [ -z "$dev" ]; then
      echo "gfx803: GFX803_PIN_MCLK=1, but no AMD card with pp_dpm_mclk was found; memory clock left as is" >&2
    else
      top=$(($(wc -l < "$dev/pp_dpm_mclk") - 1))
      echo "Pinning the memory clock at its top state ($(sed -n "$((top + 1))p" "$dev/pp_dpm_mclk" | awk '{print $2}')); undo with: echo auto | sudo tee $dev/power_dpm_force_performance_level"
      echo manual | sudo tee "$dev/power_dpm_force_performance_level" >/dev/null
      echo "$top" | sudo tee "$dev/pp_dpm_mclk" >/dev/null
    fi
  fi
fi

if ! running; then
  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "image $IMAGE not found; build it first (see README.md)"
  docker ps --format '{{.Names}}' | grep -qx comfyui \
    && die "start-comfyui.sh's container is running; stop it first (it would compete for the GPU and port 8188)"
  docker rm "$NAME" >/dev/null 2>&1 || true
  # shellcheck source=container-args.sh
  . "$LINE_DIR/container-args.sh"
  gfx803_container_args "$LINE_DIR"
  # --init: the service is PID 1's child, so docker stop's SIGTERM reaches it
  # and it can interrupt training cleanly instead of being killed.
  docker run -d --init --name "$NAME" --network host --pid host --stop-timeout "$STOP_TIMEOUT" \
    "${GFX803_ARGS[@]}" "$IMAGE" gfx803-service >/dev/null
  for _ in $(seq 20); do
    docker exec "$NAME" test -f /workspace/queue/queue.json 2>/dev/null && break
    sleep 0.5
  done
fi

# On a text console the UI gets the mouse from gpm through console_mouse.py;
# elsewhere that wrapper just runs the command.
MOUSE=()
BRIDGE="$LINE_DIR/../tools/console-mouse/console_mouse.py"
[ -f "$BRIDGE" ] && command -v python3 >/dev/null && MOUSE=(python3 "$BRIDGE" --)
"${MOUSE[@]}" docker exec -it -e TERM -e COLORTERM "$NAME" gfx803-app || true
if running; then
  echo "The gfx803 service keeps running (training and ComfyUI continue)."
  echo "Reopen the UI: $0    Shut down: $0 --stop"
fi
