+// GFX803_LOGICAL_WARP_SMEM: width of the "warp" that the device code in this file and its callers
+// index by, as a host value. C10_WARP_SIZE is 32 in device code for every AMD target except gfx9 and
+// cannot be used in host code, while at::cuda::warp_size() reports the hardware's 64 on gfx6-8.
+// BlockReduce* keep one shared-memory slot per C10_WARP_SIZE threads, so a launch that sizes that
+// buffer by block / warp_size() gets half the slots the device writes.
+inline int device_warp_size() {
+#ifdef USE_ROCM
+  const auto* prop = at::cuda::getCurrentDeviceProperties();
+  if (prop->warpSize == 64 && std::strncmp(prop->gcnArchName, "gfx9", 4) != 0) {
+    return 32;
+  }
+#endif
+  return at::cuda::warp_size();
+}
