new file mode 100644
index 00000000..d57ef2bc
--- /dev/null
+++ b/discover/refresh_timeout_test.go
@@ -0,0 +1,25 @@
+package discover
+
+import (
+	"testing"
+	"time"
+)
+
+func TestRefreshTimeout(t *testing.T) {
+	saved := slowestBootstrap
+	t.Cleanup(func() { slowestBootstrap = saved })
+
+	for _, tt := range []struct {
+		slowest, want time.Duration
+	}{
+		{0, 3 * time.Second},
+		{800 * time.Millisecond, 3 * time.Second},
+		{7 * time.Second, 14 * time.Second},
+		{25 * time.Second, 30 * time.Second},
+	} {
+		slowestBootstrap = tt.slowest
+		if got := refreshTimeout(3 * time.Second); got != tt.want {
+			t.Errorf("slowest bootstrap %v: refresh timeout %v, want %v", tt.slowest, got, tt.want)
+		}
+	}
+}
