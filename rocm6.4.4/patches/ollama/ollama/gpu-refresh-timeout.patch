+	// slowestBootstrap is the longest a library directory took to start and report its devices
+	// during the first discovery pass. The free-memory refresh starts the same library again, so
+	// it cannot finish in less time.
+	slowestBootstrap time.Duration
 )
 
+// refreshTimeout is the deadline for a free-memory refresh that has to start a new runner. A
+// refresh that misses it leaves the previous free-memory values in place, and those can date
+// from before a model was unloaded, so a GPU whose library takes longer than the base deadline
+// to start would otherwise never see memory freed: on an RX 590 (gfx803) the ROCm library alone
+// takes about 3 s to initialize. Twice the slowest first-pass discovery, within [base, 30 s],
+// leaves GPUs that start quickly at the base deadline.
+func refreshTimeout(base time.Duration) time.Duration {
+	return min(max(base, 2*slowestBootstrap), 30*time.Second)
+}
