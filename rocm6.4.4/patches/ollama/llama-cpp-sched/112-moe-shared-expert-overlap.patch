+// A device split followed by a host split (with MoE experts in system RAM: attention and routing on the
+// GPU, then the routed experts on the CPU) is computed in two parts when the host split reads only part
+// of it. The host split's inputs are copied once the head is done, and the CPU computes while the GPU
+// runs the tail (the shared expert). Returns the number of nodes in the head, or the split's node count
+// when there is no such split.
+static int ggml_backend_sched_host_inputs_end(ggml_backend_sched_t sched, int split_id) {
+    const struct ggml_backend_sched_split * split = &sched->splits[split_id];
+    const int n_nodes = split->graph.n_nodes;
+    if (!sched->host_inputs_ready[split->backend_id] || split_id + 1 >= sched->n_splits) {
+        return n_nodes;
+    }
+    const struct ggml_backend_sched_split * next = &sched->splits[split_id + 1];
+    if (!ggml_backend_buft_is_host(sched->bufts[next->backend_id])) {
+        return n_nodes;
+    }
+
+    // a view computes nothing: the host split's copy reads the tensor the view points into
+    int last = -1;
+    for (int j = 0; j < n_nodes; j++) {
+        for (int i = 0; i < next->n_inputs; i++) {
+            const struct ggml_tensor * input = next->inputs[i];
+            if (split->graph.nodes[j] == (input->view_src ? input->view_src : input)) {
+                last = j;
+            }
+        }
+    }
+    if (last < 0) {
+        return n_nodes;
+    }
+
+    // the nodes right after it that consume it stay in the head: a backend fuses such a chain (top-k
+    // MoE routing: argsort, get_rows, weight normalization) only when it is computed in one graph
+    int end = last + 1;
+    while (end < n_nodes) {
+        const struct ggml_tensor * t = split->graph.nodes[end];
+        bool consumes = false;
+        for (int k = 0; k < GGML_MAX_SRC && t->src[k] && !consumes; k++) {
+            const struct ggml_tensor * src = t->src[k]->view_src ? t->src[k]->view_src : t->src[k];
+            for (int j = last; j < end && !consumes; j++) {
+                consumes = split->graph.nodes[j] == src || split->graph.nodes[j] == t->src[k];
+            }
+        }
+        if (!consumes) {
+            break;
+        }
+        end++;
+    }
+    return end;
+}
