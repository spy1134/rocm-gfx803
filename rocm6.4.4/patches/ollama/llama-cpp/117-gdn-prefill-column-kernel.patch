+// Prompt-batch kernel for S_v == 128. The wave-per-column kernel above needs two wave-wide reductions per token
+// for a few multiply-adds per lane, so over a long batch it runs at a few percent of the ALU rate. Here two
+// neighbouring lanes own one column (64 rows each, held in registers) and the only cross-lane step per dot
+// product is one exchange between the pair. One lane per column would need 128 state registers and halve the
+// waves: a 32-head layer at one sequence would get 64 waves, fewer than the 144 SIMDs of an RX 590. Every lane
+// of a block needs the same k_t, q_t and gate, so a chunk of tokens is staged in shared memory once with
+// coalesced loads and then read as broadcasts.
+namespace gdn_col {
+constexpr int S_v             = 128;
+constexpr int cols_per_block  = 64;
+constexpr int threads         = 2 * cols_per_block;
+constexpr int rows_per_thread = S_v / 2;
+// tokens per LDS chunk; KDA stages a full gate row per token as well. Both stay under 32 KB so that two blocks
+// fit on one CU (the grid has only H * n_seqs * 2 blocks).
+template <bool KDA> constexpr int chunk = KDA ? 8 : 16;
+}
+
+static __device__ __forceinline__ float gdn_col_pair_sum(const float x) {
+#ifdef GGML_USE_HIP
+    // quad_perm [1,0,3,2] swaps neighbouring lanes in one DPP move; x + y == y + x, so both lanes of the pair
+    // hold the same bits
+    const float y = __int_as_float(__builtin_amdgcn_mov_dpp(__float_as_int(x), 0xB1, 0xF, 0xF, true));
+#else
+    const float y = __shfl_xor_sync(0xffffffff, x, 1);
+#endif
+    return x + y;
+}
+
+// rows of lane half h: 8*m + 4*h + e (m < 16, e < 4), so both lanes of a pair read neighbouring float4s of the
+// same LDS row and the state of one column is read and written as float4s.
+// One block per CU at minimum: the 64 state rows plus a token's k and q take about 160 VGPRs; on AMD that is
+// one wave per SIMD, and the four waves of two blocks still cover a CU's four SIMDs.
+template <bool KDA, bool keep_rs_t, bool state_ids_t>
+__global__ void __launch_bounds__(gdn_col::threads, 1)
+gated_delta_net_col_cuda(const float * q,
+                         const float * k,
+                         const float * v,
+                         const float * g,
+                         const float * beta,
+                         const float * curr_state,
+                         float *       dst,
+                         float *       state,
+                         int64_t       H,
+                         int64_t       n_tokens,
+                         int64_t       n_seqs,
+                         int64_t       sq1,
+                         int64_t       sq2,
+                         int64_t       sq3,
+                         int64_t       sv1,
+                         int64_t       sv2,
+                         int64_t       sv3,
+                         int64_t       sb1,
+                         int64_t       sb2,
+                         int64_t       sb3,
+                         const uint3   neqk1_magic,
+                         const uint3   rq3_magic,
+                         float         scale,
+                         int64_t       state_slot_stride,
+                         int           K,
+                         const int32_t * state_ids,
+                         int64_t       state_ids_row_stride) {
+    using namespace gdn_col;
+    constexpr int T  = chunk<KDA>;
+    constexpr int NG = KDA ? T * S_v : T;
+
+    __shared__ __align__(16) float s_k[T][S_v];
+    __shared__ __align__(16) float s_q[T][S_v];
+    __shared__ __align__(16) float s_g[NG]; // expf(g), the form both formulas use
+    __shared__ float s_beta[T];
+    __shared__ float s_v[T][cols_per_block];
+
+    const int      tid      = threadIdx.x;
+    const int      half     = tid & 1;
+    const int      cl       = tid >> 1;
+    const int      col      = blockIdx.z * cols_per_block + cl;
+    const uint32_t h_idx    = blockIdx.x;
+    const uint32_t sequence = blockIdx.y;
+
+    const uint32_t iq1 = fastmodulo(h_idx, neqk1_magic);
+    const uint32_t iq3 = fastdiv(sequence, rq3_magic);
+
+    float * attn_data = dst + ((int64_t) sequence * n_tokens * H + h_idx) * S_v + col;
+    state += ((int64_t) sequence * H + h_idx) * S_v * S_v + col * S_v + 4 * half;
+
+    ggml_cuda_pdl_sync();
+    const float * s_in;
+    if constexpr (state_ids_t) {
+        // read from the cache row that the fused snapshot store may overwrite in place: safe, each lane reads
+        // all of its rows here before it writes any of them, and no lane writes another lane's rows
+        s_in = curr_state + (int64_t) state_ids[sequence] * state_ids_row_stride;
+    } else {
+        s_in = curr_state + (int64_t) sequence * H * S_v * S_v;
+    }
+    s_in += (int64_t) h_idx * S_v * S_v + col * S_v + 4 * half;
+
+    float s[rows_per_thread];
+#pragma unroll
+    for (int m = 0; m < rows_per_thread / 4; m++) {
+        const float4 x = *reinterpret_cast<const float4 *>(s_in + 8 * m);
+        s[4 * m + 0] = x.x;
+        s[4 * m + 1] = x.y;
+        s[4 * m + 2] = x.z;
+        s[4 * m + 3] = x.w;
+    }
+
+    for (int64_t t0 = 0; t0 < n_tokens; t0 += T) {
+        const int nt = (int) (n_tokens - t0 < T ? n_tokens - t0 : T);
+
+        __syncthreads();
+        for (int idx = tid; idx < nt * S_v; idx += threads) {
+            const int     tt = idx / S_v;
+            const int     i  = idx % S_v;
+            const int64_t t  = t0 + tt;
+            const int64_t qk = iq3 * sq3 + t * sq2 + iq1 * sq1 + i;
+            s_k[tt][i] = k[qk];
+            s_q[tt][i] = q[qk];
+            if constexpr (KDA) {
+                s_g[idx] = expf(g[(sequence * sb3 + t * sb2 + h_idx * sb1) * S_v + i]);
+            }
+        }
+        for (int idx = tid; idx < nt * cols_per_block; idx += threads) {
+            const int tt = idx / cols_per_block;
+            const int c  = idx % cols_per_block;
+            s_v[tt][c] = v[sequence * sv3 + (t0 + tt) * sv2 + h_idx * sv1 + blockIdx.z * cols_per_block + c];
+        }
+        if (tid < nt) {
+            const int64_t gb = sequence * sb3 + (t0 + tid) * sb2 + h_idx * sb1;
+            s_beta[tid] = beta[gb];
+            if constexpr (!KDA) {
+                s_g[tid] = expf(g[gb]);
+            }
+        }
+        __syncthreads();
+
+        for (int tt = 0; tt < nt; tt++) {
+            const float4 * k4 = reinterpret_cast<const float4 *>(s_k[tt]) + half;
+            const float4 * q4 = reinterpret_cast<const float4 *>(s_q[tt]) + half;
+            const float4 * g4 = reinterpret_cast<const float4 *>(s_g + (KDA ? tt * S_v : 0)) + half;
+            const float beta_val = s_beta[tt];
+
+            float attn = 0.0f;
+            if constexpr (!KDA) {
+                const float g_val = s_g[tt];
+
+                // kv[col] = sum_i S[i][col] * k[i]
+                float kv = 0.0f;
+#pragma unroll
+                for (int m = 0; m < rows_per_thread / 4; m++) {
+                    const float4 kk = k4[2 * m];
+                    kv += s[4 * m + 0] * kk.x;
+                    kv += s[4 * m + 1] * kk.y;
+                    kv += s[4 * m + 2] * kk.z;
+                    kv += s[4 * m + 3] * kk.w;
+                }
+                kv = gdn_col_pair_sum(kv);
+
+                const float delta = (s_v[tt][cl] - g_val * kv) * beta_val;
+
+                // S[i][col] = g * S[i][col] + k[i] * delta; attn[col] = sum_i S[i][col] * q[i]
+#pragma unroll
+                for (int m = 0; m < rows_per_thread / 4; m++) {
+                    const float4 kk = k4[2 * m];
+                    const float4 qq = q4[2 * m];
+                    s[4 * m + 0] = g_val * s[4 * m + 0] + kk.x * delta;
+                    attn += s[4 * m + 0] * qq.x;
+                    s[4 * m + 1] = g_val * s[4 * m + 1] + kk.y * delta;
+                    attn += s[4 * m + 1] * qq.y;
+                    s[4 * m + 2] = g_val * s[4 * m + 2] + kk.z * delta;
+                    attn += s[4 * m + 2] * qq.z;
+                    s[4 * m + 3] = g_val * s[4 * m + 3] + kk.w * delta;
+                    attn += s[4 * m + 3] * qq.w;
+                }
+            } else {
+                // kv[col] = sum_i g[i] * S[i][col] * k[i]
+                float kv = 0.0f;
+#pragma unroll
+                for (int m = 0; m < rows_per_thread / 4; m++) {
+                    const float4 kk = k4[2 * m];
+                    const float4 gg = g4[2 * m];
+                    kv += gg.x * s[4 * m + 0] * kk.x;
+                    kv += gg.y * s[4 * m + 1] * kk.y;
+                    kv += gg.z * s[4 * m + 2] * kk.z;
+                    kv += gg.w * s[4 * m + 3] * kk.w;
+                }
+                kv = gdn_col_pair_sum(kv);
+
+                const float delta = (s_v[tt][cl] - kv) * beta_val;
+
+                // S[i][col] = g[i] * S[i][col] + k[i] * delta; attn[col] = sum_i S[i][col] * q[i]
+#pragma unroll
+                for (int m = 0; m < rows_per_thread / 4; m++) {
+                    const float4 kk = k4[2 * m];
+                    const float4 qq = q4[2 * m];
+                    const float4 gg = g4[2 * m];
+                    s[4 * m + 0] = gg.x * s[4 * m + 0] + kk.x * delta;
+                    attn += s[4 * m + 0] * qq.x;
+                    s[4 * m + 1] = gg.y * s[4 * m + 1] + kk.y * delta;
+                    attn += s[4 * m + 1] * qq.y;
+                    s[4 * m + 2] = gg.z * s[4 * m + 2] + kk.z * delta;
+                    attn += s[4 * m + 2] * qq.z;
+                    s[4 * m + 3] = gg.w * s[4 * m + 3] + kk.w * delta;
+                    attn += s[4 * m + 3] * qq.w;
+                }
+            }
+            attn = gdn_col_pair_sum(attn);
+
+            const int64_t t = t0 + tt;
+            if (half == 0) {
+                attn_data[t * S_v * H] = attn * scale;
+            }
+
+            if constexpr (keep_rs_t) {
+                // slot 0 = most recent state, slot s = s tokens back; older slots are caller-owned
+                const int64_t target_slot = n_tokens - 1 - t;
+                if (target_slot < K) {
+                    float * out = state + target_slot * state_slot_stride;
+#pragma unroll
+                    for (int m = 0; m < rows_per_thread / 4; m++) {
+                        *reinterpret_cast<float4 *>(out + 8 * m) =
+                            make_float4(s[4 * m + 0], s[4 * m + 1], s[4 * m + 2], s[4 * m + 3]);
+                    }
+                }
+            }
+        }
+    }
+
+    if constexpr (!keep_rs_t) {
+#pragma unroll
+        for (int m = 0; m < rows_per_thread / 4; m++) {
+            *reinterpret_cast<float4 *>(state + 8 * m) =
+                make_float4(s[4 * m + 0], s[4 * m + 1], s[4 * m + 2], s[4 * m + 3]);
+        }
+    }
+}
+
+static bool gdn_col_aligned(const void * p) {
+    return ((uintptr_t) p & 15) == 0;
+}
+
