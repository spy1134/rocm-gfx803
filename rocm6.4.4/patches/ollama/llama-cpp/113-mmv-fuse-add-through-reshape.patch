llama.cpp (as fetched by Ollama v0.35.1, llama.cpp b11232, applied after
100-112): a matrix-vector product also performs the ADD that reads it
through a reshape, so the ADD is no longer a dispatch of its own.
Generic (all GPUs): not gfx803-specific code; measured on gfx803.

WHY
---
Single-token decode on an RX 590 pays for every dispatch as well as for the
work in it: each one costs about 4.3 us of command-processor time however
small the kernel, a 2.65 us floor plus 1.65 us for the vector-L1 invalidate
that every dispatch needs on gfx8 (docs/FINDINGS.md, "A kernel can read
stale data from the vector L1 across dispatches"). A Qwen3.6 35B-A3B decode
token with the routed experts in system RAM issues about 1,425 dispatches,
about 1,064 of them on the critical path.

The CUDA backend already folds MUL_MAT -> ADD into the matrix-vector
kernels' bias epilogue (x_bias of mul_mat_vec_q and mul_mat_vec_f). Gated
DeltaNet layers (Qwen3.5/3.6, Qwen3-Next) put a RESHAPE between the two in
two places at one token: the output projection ssm_out before the residual
add, and the alpha projection before the add of ssm_dt. The reshape keeps
the product's shape, strides and bytes, but it breaks the pattern, so each
of those ADDs runs as a kernel of its own: 60 dispatches per token on
Qwen3.6 35B-A3B (30 DeltaNet layers).

Alone, with HIP graphs off (tg128 x5, two rounds): 26.30 -> 26.54 tok/s (+0.9%).

Measured on an RX 590 (llama-bench, Qwen3.6 35B-A3B Q4_K_M, all experts in
system RAM with -ncmoe 99, tg128, 5 repetitions, page cache dropped before
each run, HSA_ENABLE_SDMA=1 ROC_CPU_WAIT_FOR_SIGNAL=1), patches 113-116
together: 25.60 -> 27.51 tok/s with HIP graphs (the default), 26.21 ->
27.93 tok/s with GGML_CUDA_DISABLE_GRAPHS=1. With this patch alone and with
all four, greedy 128-token output is byte-identical to the build without
them, and llama-perplexity with -ub 1 (every token through the decode path)
gives mean KLD 0 and the same perplexity in every digit.

WHAT
----
ggml_cuda_try_fuse_mm_reshape_add, called from ggml_cuda_try_fuse for a
MUL_MAT, matches MUL_MAT at i, a RESHAPE or VIEW at i+1 of the product with
offset 0 and the product's type, shape and strides, and an f32 ADD at i+2
that reads the reshape with a same-shape f32 operand. The product and the
reshape must have one use each and the reshape must not be a graph output.
The product then runs as the fused mmvf or mmvq kernel with the other
operand as x_bias and the ADD as its destination, the same call the
MUL_MAT -> ADD fusion makes. On the mmvf path the ADD's output must not
overlap src1: mmvf reads src1 in the kernel that writes the sum (mmvq
reads its q8_1 copy). Products the fused matrix-vector kernels do not take
(more than one token, other types) run unfused as before, and
GGML_CUDA_DISABLE_FUSION=1 turns this off with the other fusions.

Numerics are unchanged: both kernels add the bias to the fully reduced dot
product, one rounding as in the separate ADD, with no new fma.

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 390a371..1b9b876 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3489,6 +3489,91 @@ static bool ggml_cuda_can_fuse(const struct ggml_cgraph *                cgraph,
     return false;
 }
 
+static int32_t ggml_cuda_node_use_count(const ggml_cgraph * cgraph, const ggml_tensor * t) {
+    const size_t pos = ggml_hash_find(&cgraph->visited_hash_set, t);
+    if (pos == GGML_HASHSET_FULL || !ggml_bitset_get(cgraph->visited_hash_set.used, pos) ||
+            cgraph->visited_hash_set.keys[pos] != t) {
+        return 0;
+    }
+    return cgraph->use_counts[pos];
+}
+
+static bool ggml_cuda_bytes_overlap(const void * a, size_t na, const void * b, size_t nb) {
+    const char * a0 = (const char *) a;
+    const char * b0 = (const char *) b;
+    return na > 0 && nb > 0 && a0 < b0 + nb && b0 < a0 + na;
+}
+
+static bool ggml_cuda_bytes_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    return ggml_cuda_bytes_overlap(a->data, ggml_nbytes(a), b->data, ggml_nbytes(b));
+}
+
+static const ggml_tensor * ggml_cuda_other_src(const ggml_tensor * node, const ggml_tensor * x) {
+    if (node->src[0] == x) {
+        return node->src[1];
+    }
+    if (node->src[1] == x) {
+        return node->src[0];
+    }
+    return nullptr;
+}
+
+// MUL_MAT -> RESHAPE/VIEW -> ADD where the reshape keeps the product's shape, strides and bytes (Gated
+// DeltaNet at one token: ssm_out + residual, alpha + ssm_dt). The ADD then reads exactly what the
+// product wrote, so the product adds the other operand itself, as the MUL_MAT -> ADD fusion does when
+// nothing sits between the two. Both kernels add the bias after the full dot product: the same single
+// rounding as the separate ADD.
+static int ggml_cuda_try_fuse_mm_reshape_add(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    if (i + 2 >= cgraph->n_nodes) {
+        return 0;
+    }
+    ggml_tensor * mm_node = cgraph->nodes[i];
+    ggml_tensor * reshape = cgraph->nodes[i + 1];
+    ggml_tensor * add     = cgraph->nodes[i + 2];
+
+    if (mm_node->op != GGML_OP_MUL_MAT || mm_node->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm_node)) {
+        return 0;
+    }
+    if ((reshape->op != GGML_OP_RESHAPE && reshape->op != GGML_OP_VIEW) || reshape->src[0] != mm_node ||
+            reshape->view_src != mm_node || reshape->view_offs != 0 || reshape->type != mm_node->type ||
+            !ggml_are_same_shape(reshape, mm_node) || !ggml_are_same_stride(reshape, mm_node)) {
+        return 0;
+    }
+    if (add->op != GGML_OP_ADD || add->type != GGML_TYPE_F32 || (add->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+            !ggml_are_same_shape(add->src[0], add->src[1])) {
+        return 0;
+    }
+    const ggml_tensor * bias = ggml_cuda_other_src(add, reshape);
+    if (bias == nullptr || bias == reshape || bias->type != GGML_TYPE_F32) {
+        return 0;
+    }
+    if (!ggml_node_has_n_uses(cgraph, i, 1) || ggml_cuda_node_use_count(cgraph, reshape) != 1 ||
+            (reshape->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+
+    const ggml_tensor * src0 = mm_node->src[0];
+    const ggml_tensor * src1 = mm_node->src[1];
+
+    ggml_cuda_mm_fusion_args_host fusion_data{};
+    fusion_data.x_bias = bias;
+
+    if (ggml_cuda_should_fuse_mul_mat_vec_f(mm_node)) {
+        // mmvf reads src1 in the kernel that writes the sum (mmvq reads its q8_1 copy instead), and the
+        // sum may sit in src1's bytes: src1 has no reader after the product
+        if (ggml_cuda_bytes_overlap(add, src1)) {
+            return 0;
+        }
+        ggml_cuda_mul_mat_vec_f(*cuda_ctx, src0, src1, nullptr, add, &fusion_data);
+        return 2;
+    }
+    if (ggml_cuda_should_fuse_mul_mat_vec_q(mm_node)) {
+        ggml_cuda_mul_mat_vec_q(*cuda_ctx, src0, src1, nullptr, add, &fusion_data);
+        return 2;
+    }
+    return 0;
+}
+
 // try and fuse nodes and return the number of nodes to skip
