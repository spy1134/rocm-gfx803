 #endif // defined(GGML_USE_HIP)
 }
 
+// The SDWA sequence above pays off on gfx803 only in the decode kernels (mmvq
+// and flash attention), where not keeping unpacked bytes live keeps them
+// under 128 VGPRs. Elsewhere the compiler's byte-wise code is faster: the mmq
+// prompt kernels ran up to 21% slower with SDWA (q8_0 tiles, which the IQ
+// types also use), and dot products whose operand comes from
+// get_int_from_table_16 (iq4_nl, iq4_xs, mxfp4, nvfp4) up to 2.6x slower.
+// Those call this instead.
+static __device__ __forceinline__ int ggml_cuda_dp4a_plain(const int a, const int b, int c) {
+#if defined(GGML_USE_HIP) && (defined(GCN4) || defined(__gfx803__))
+    const int8x4_t va = reinterpret_cast<const int8x4_t&>(a);
+    const int8x4_t vb = reinterpret_cast<const int8x4_t&>(b);
+    return c + va[0] * vb[0] + va[1] * vb[1] + va[2] * vb[2] + va[3] * vb[3];
+#else
+    return ggml_cuda_dp4a(a, b, c);
+#endif
+}
+
+template <bool plain>
+static __device__ __forceinline__ int ggml_cuda_dp4a_sel(const int a, const int b, int c) {
+    if constexpr (plain) {
+        return ggml_cuda_dp4a_plain(a, b, c);
+    } else {
+        return ggml_cuda_dp4a(a, b, c);
+    }
+}
