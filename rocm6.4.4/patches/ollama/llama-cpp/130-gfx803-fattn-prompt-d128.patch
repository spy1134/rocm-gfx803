+
+// A 96-row block (R = 3) takes about a fifth less time per query row than a 64-row block (R = 2),
+// but pads the batch further and leaves a different tail on the last wave of blocks. The estimate
+// counts query rows per CU over whole waves, or over the blocks alone where launch_fattn splits the
+// K/V range to fill the GPU. On an RX 590 the pick is within 2.9% of the faster block size on
+// geometric mean over batches of 64-2048 queries, 512-16384 keys and GQA ratios 1-8.
+template <int D>
+static void ggml_cuda_flash_attn_ext_gcn4_prompt_qreg(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * Q = dst->src[0];
+    const int nsm = ggml_cuda_info().devices[ggml_cuda_get_device()].nsm;
+
+    auto rows_per_cu = [&](const int rows, const float row_cost) {
+        const int64_t blocks = (Q->ne[1] + rows - 1)/rows * Q->ne[2]*Q->ne[3];
+        const int64_t waves  = (blocks + nsm - 1)/nsm;
+        const float   slots  = 100*blocks >= 75*waves*nsm ? float(waves) : float(blocks)/nsm;
+        return slots*rows*row_cost;
+    };
+    if (rows_per_cu(96, 0.8f) < rows_per_cu(64, 1.0f)) {
+        ggml_cuda_flash_attn_ext_gcn4_prompt_qreg_case<D, 3>(ctx, dst);
+    } else {
+        ggml_cuda_flash_attn_ext_gcn4_prompt_qreg_case<D, 2>(ctx, dst);
+    }
+}
