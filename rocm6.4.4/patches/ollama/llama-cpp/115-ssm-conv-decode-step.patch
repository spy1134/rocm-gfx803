+
+// One decode step of the conv chain GET_ROWS(conv state) -> CONCAT(state, x) ->
+// CPY(last d_conv-1 columns -> cache row) -> SSM_CONV -> SILU, for one sequence and one token. Each
+// thread owns one channel: it reads that channel's d_conv-1 state values from the cache row the row ids
+// name and the channel's new input, writes the shifted window to the cache row of this step, and
+// computes the convolution with the same expressions and summation order as ssm_conv_f32 at n_t == 1.
+// The in-place case (both rows the same) is safe because a thread writes only the values it read.
+template <size_t d_conv>
+static __global__ void ssm_conv_step_silu_f32(const float * cache, const int32_t * ids, const int64_t row_stride,
+                                              const float * x_new, const int64_t x_new_stride,
+                                              const float * w_ptr, const int w_nb1, float * state_out,
+                                              float * dst, const int nr) {
+    const int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= nr) {
+        return;
+    }
+
+    const float * state_in = cache + (int64_t) ids[0] * row_stride + (int64_t) tid * (d_conv - 1);
+    const int     stride_w = w_nb1 / sizeof(float);
+
+    float x[d_conv] = { 0.0f };
+    float w[d_conv] = { 0.0f };
+
+#pragma unroll
+    for (size_t j = 0; j < d_conv; j++) {
+        w[j] = w_ptr[tid * stride_w + j];
+    }
+
+    const float b = 0.0f;
+
+#pragma unroll
+    for (size_t j = 0; j < d_conv - 1; j++) {
+        x[j] = state_in[j];
+    }
+    x[d_conv - 1] = x_new[tid * x_new_stride];
+
+#pragma unroll
+    for (size_t j = 0; j < d_conv - 1; j++) {
+        state_out[(int64_t) tid * (d_conv - 1) + j] = x[j + 1];
+    }
+
+    float sumf = 0.0f;
+#pragma unroll
+    for (size_t j = 0; j < d_conv; j++) {
+        sumf += x[j] * w[j];
+    }
+    sumf += b;
+    dst[tid] = ggml_cuda_op_silu_single(sumf);
+}
+
+bool ggml_cuda_ssm_conv_step_supported(const ggml_tensor * ssm_conv, const ggml_tensor * silu) {
+    const ggml_tensor * w = ssm_conv->src[1];
+    const int64_t nc = w->ne[0];
+    return (nc == 3 || nc == 4) && w->type == GGML_TYPE_F32 && w->nb[0] == sizeof(float) &&
+        silu->type == GGML_TYPE_F32 && ggml_is_contiguous(silu) && silu->ne[0] == ssm_conv->src[0]->ne[1] &&
+        silu->ne[1] == 1 && silu->ne[2] == 1 && silu->ne[3] == 1;
+}
+
+void ggml_cuda_op_ssm_conv_step(ggml_backend_cuda_context & ctx, const ggml_tensor * ssm_conv, ggml_tensor * silu,
+                                const float * cache, const int32_t * ids, int64_t row_stride,
+                                const float * x_new, int64_t x_new_stride, float * state_out) {
+    const ggml_tensor * w  = ssm_conv->src[1];
+    const int64_t       nc = w->ne[0];
+    const int           nr = (int) silu->ne[0];
+    GGML_ASSERT(ggml_cuda_ssm_conv_step_supported(ssm_conv, silu));
+
+    const int    threads = 128;
+    const dim3   blocks((nr + threads - 1) / threads, 1, 1);
+    cudaStream_t stream  = ctx.stream();
+    if (nc == 4) {
+        ssm_conv_step_silu_f32<4><<<blocks, threads, 0, stream>>>(cache, ids, row_stride, x_new, x_new_stride,
+            (const float *) w->data, (int) w->nb[1], state_out, (float *) silu->data, nr);
+    } else {
+        ssm_conv_step_silu_f32<3><<<blocks, threads, 0, stream>>>(cache, ids, row_stride, x_new, x_new_stride,
+            (const float *) w->data, (int) w->nb[1], state_out, (float *) silu->data, nr);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
