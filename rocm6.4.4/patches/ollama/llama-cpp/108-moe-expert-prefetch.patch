+// MoE expert prefetch.
+//
+// With op offload, a GPU split whose MUL_MAT_ID reads expert weights kept in host memory copies
+// them to the GPU first. The copy normally waits for that layer's router output (to copy only the
+// experts used) and runs on the compute stream, so the GPU idles for the whole PCIe transfer of
+// every MoE layer: about 1.5 of 7 s per 2048-token batch of Qwen3.6 35B-A3B with all experts in
+// host memory, and more than half the time at 512-token batches. Once a batch is large enough that
+// almost every expert is used (tokens x experts-per-token >= 4 x experts, so under 2% go unused),
+// copying all of them costs the same, needs no router output, and can start early. Such splits get
+// their host weights in one of two device slots outside the graph allocator, alternating from one
+// MoE split to the next; a second backend instance on the same device (its own stream) copies the
+// next split's weights into the other slot while the current split computes. Events order the
+// copy after the slot's previous user and the compute after its copy.
+//
+// VRAM cost: two slots, each the largest one split's host weights, instead of the one copy the graph
+// allocator would place; the scheduler reports the slots in its buffer size, so memory fitting
+// counts them. GGML_SCHED_EXPERT_PREFETCH=0 disables it.
+
+static bool ggml_backend_sched_is_host_weight(const struct ggml_tensor * t) {
+    return t->buffer && !(t->flags & GGML_TENSOR_FLAG_INPUT) &&
+           ggml_backend_buffer_get_usage(t->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS &&
+           ggml_backend_buffer_is_host(t->buffer);
+}
+
+static bool ggml_backend_sched_split_prefetchable(ggml_backend_sched_t sched, struct ggml_backend_sched_split * split) {
+    if (split->backend_id == sched->n_backends - 1) {
+        return false;
+    }
+    for (int i = 0; i < split->graph.n_nodes; i++) {
+        const struct ggml_tensor * node = split->graph.nodes[i];
+        if (node->op != GGML_OP_MUL_MAT_ID) {
+            continue;
+        }
+        for (int j = 0; j < split->n_inputs; j++) {
+            struct ggml_tensor * input = split->inputs[j];
+            if (!ggml_backend_sched_is_host_weight(input) || node->src[0] != tensor_copy(input, split->backend_id, 0)) {
+                continue;
+            }
+            const struct ggml_tensor * ids = node->src[2];
+            if (ids->ne[0] * ids->ne[1] >= 4 * input->ne[2]) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static void ggml_backend_sched_disable_expert_prefetch(ggml_backend_sched_t sched, const char * why) {
+    GGML_LOG_WARN("%s: MoE expert prefetch disabled: %s\n", __func__, why);
+    sched->expert_prefetch = false;
+    for (int i = 0; i < sched->n_splits; i++) {
+        sched->expert_split_slot[i] = -1;
+    }
+}
+
+static void ggml_backend_sched_expert_sync(ggml_backend_sched_t sched) {
+    for (int b = 0; b < sched->n_backends; b++) {
+        ggml_backend_synchronize(sched->backends[b]);
+        if (sched->expert_copy_backend[b]) {
+            ggml_backend_synchronize(sched->expert_copy_backend[b]);
+        }
+    }
+}
+
+// Picks the splits to prefetch and, with allocate, places their host weights' copies in the slots
+// (growing the slots if needed). Without allocate only the needed slot size is recorded, for
+// ggml_backend_sched_reserve_size.
+static void ggml_backend_sched_assign_expert_slots(ggml_backend_sched_t sched, bool allocate) {
+    if (sched->expert_split_slot_cap < sched->n_splits) {
+        sched->expert_split_slot_cap = sched->splits_capacity;
+        sched->expert_split_slot = (int *) realloc(sched->expert_split_slot, sched->expert_split_slot_cap * sizeof(int));
+    }
+    for (int i = 0; i < sched->n_splits; i++) {
+        sched->expert_split_slot[i] = -1;
+    }
+    for (int b = 0; b < sched->n_backends; b++) {
+        sched->expert_slot_need[b] = 0;
+    }
+    if (!sched->expert_prefetch || sched->n_copies != 1 || !sched->op_offload) {
+        return;
+    }
+
+    int count[GGML_SCHED_MAX_BACKENDS] = { 0 };
+    for (int i = 0; i < sched->n_splits; i++) {
+        struct ggml_backend_sched_split * split = &sched->splits[i];
+        if (!ggml_backend_sched_split_prefetchable(sched, split)) {
+            continue;
+        }
+        const int b = split->backend_id;
+        ggml_backend_buffer_type_t buft = sched->bufts[b];
+        const size_t align = ggml_backend_buft_get_alignment(buft);
+        size_t offset = 0;
+        for (int j = 0; j < split->n_inputs; j++) {
+            if (ggml_backend_sched_is_host_weight(split->inputs[j])) {
+                offset = GGML_PAD(offset, align) + ggml_backend_buft_get_alloc_size(buft, tensor_copy(split->inputs[j], b, 0));
+            }
+        }
+        sched->expert_split_slot[i] = count[b]++ % 2;
+        sched->expert_slot_need[b] = std::max(sched->expert_slot_need[b], offset);
+    }
+    if (!allocate) {
+        return;
+    }
+
+    for (int b = 0; b < sched->n_backends; b++) {
+        if (sched->expert_slot_need[b] <= sched->expert_slot_size[b]) {
+            continue;
+        }
+        ggml_backend_sched_expert_sync(sched);
+        ggml_backend_dev_t dev = ggml_backend_get_device(sched->backends[b]);
+        if (!sched->expert_copy_backend[b]) {
+            sched->expert_copy_backend[b] = ggml_backend_dev_init(dev, NULL);
+            for (int s = 0; s < 2; s++) {
+                sched->expert_copy_done[b][s]    = ggml_backend_event_new(dev);
+                sched->expert_compute_done[b][s] = ggml_backend_event_new(dev);
+            }
+        }
+        if (!sched->expert_copy_backend[b] || !sched->expert_copy_done[b][0] || !sched->expert_copy_done[b][1] ||
+            !sched->expert_compute_done[b][0] || !sched->expert_compute_done[b][1]) {
+            ggml_backend_sched_disable_expert_prefetch(sched, "no second stream or events on this device");
+            return;
+        }
+        for (int s = 0; s < 2; s++) {
+            ggml_backend_buffer_free(sched->expert_slot_buf[b][s]);
+            sched->expert_slot_buf[b][s] = ggml_backend_buft_alloc_buffer(sched->bufts[b], sched->expert_slot_need[b]);
+            if (!sched->expert_slot_buf[b][s]) {
+                ggml_backend_sched_disable_expert_prefetch(sched, "slot allocation failed");
+                return;
+            }
+            // MMQ reads the padding after a quantized tensor's last row: keep it zero, not stale data
+            ggml_backend_buffer_clear(sched->expert_slot_buf[b][s], 0);
+            sched->expert_compute_recorded[b][s] = false;
+        }
+        sched->expert_slot_size[b] = sched->expert_slot_need[b];
+    }
+
+    for (int i = 0; i < sched->n_splits; i++) {
+        const int s = sched->expert_split_slot[i];
+        if (s < 0) {
+            continue;
+        }
+        struct ggml_backend_sched_split * split = &sched->splits[i];
+        const int b = split->backend_id;
+        ggml_backend_buffer_t buf = sched->expert_slot_buf[b][s];
+        const size_t align = ggml_backend_buft_get_alignment(sched->bufts[b]);
+        size_t offset = 0;
+        for (int j = 0; j < split->n_inputs; j++) {
+            if (!ggml_backend_sched_is_host_weight(split->inputs[j])) {
+                continue;
+            }
+            struct ggml_tensor * input_cpy = tensor_copy(split->inputs[j], b, 0);
+            offset = GGML_PAD(offset, align);
+            ggml_backend_tensor_alloc(buf, input_cpy, (char *) ggml_backend_buffer_get_base(buf) + offset);
+            offset += ggml_backend_buft_get_alloc_size(sched->bufts[b], input_cpy);
+        }
+    }
+}
+
+// Starts copying split k's host weights into its slot on the copy stream, after the slot's
+// previous user has finished.
+static void ggml_backend_sched_prefetch_split(ggml_backend_sched_t sched, int k) {
+    struct ggml_backend_sched_split * split = &sched->splits[k];
+    const int b = split->backend_id;
+    const int s = sched->expert_split_slot[k];
+    ggml_backend_t copy_backend = sched->expert_copy_backend[b];
+    if (sched->expert_compute_recorded[b][s]) {
+        ggml_backend_event_wait(copy_backend, sched->expert_compute_done[b][s]);
+    }
+    for (int j = 0; j < split->n_inputs; j++) {
+        struct ggml_tensor * input = split->inputs[j];
+        if (ggml_backend_sched_is_host_weight(input)) {
+            ggml_backend_tensor_set_async(copy_backend, tensor_copy(input, b, 0), input->data, 0, ggml_nbytes(input));
+        }
+    }
+    ggml_backend_event_record(sched->expert_copy_done[b][s], copy_backend);
+}
+
+static int ggml_backend_sched_next_prefetch_split(ggml_backend_sched_t sched, int from) {
+    for (int k = from; k < sched->n_splits; k++) {
+        if (sched->expert_split_slot[k] >= 0) {
+            return k;
+        }
+    }
+    return -1;
+}
