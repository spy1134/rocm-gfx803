+// gfx803 has no integer dot product instructions, so the K-quant and low-bit IQ dot products are
+// long ALU sequences and single-token decode is instruction-bound rather than bandwidth-bound for
+// them (Q4_K reaches 127-160 GB/s of the RX 590's ~225, against 222 for q8_0). One warp walking two
+// rows halves the per-row reduction and launch overhead and keeps more loads in flight per wave:
+// 11-31% faster per matmul for these types on an RX 590. The other types are at the bandwidth
+// limit already, and q5_K, q8_0, iq4_xs and q5_1 measured 2-7% slower with two rows.
+static constexpr __host__ __device__ bool mmvq_gcn4_two_rows(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_IQ1_S:
+        case GGML_TYPE_IQ1_M:
+        case GGML_TYPE_IQ2_XXS:
+        case GGML_TYPE_IQ2_XS:
+        case GGML_TYPE_IQ2_S:
+        case GGML_TYPE_IQ3_XXS:
+        case GGML_TYPE_MXFP4:
+        case GGML_TYPE_NVFP4:
+        case GGML_TYPE_Q2_0:
+            return true;
+        default:
+            return false;
+    }
+}
