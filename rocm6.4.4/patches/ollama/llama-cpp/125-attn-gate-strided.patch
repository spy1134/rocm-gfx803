+// The sigmoid gate of an attention output, op_sigmoid(x) * g as unary_gated_op_kernel computes it, with x read
+// in place from rows of n values o0 apart (the strided view that the graph copies out with CONT); g and dst
+// are contiguous. The same kernel instantiation as the fused unary * mul.
+void ggml_cuda_op_sigmoid_mul_strided(ggml_backend_cuda_context & ctx, const float * x, const int64_t n, const int64_t o0,
+                                      const float * g, float * dst, const int64_t k) {
+    unary_gated_cuda<op_sigmoid>(x, g, dst, k, n, o0, n, ctx.stream());
+}
