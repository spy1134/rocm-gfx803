+
+MIOPEN_DECLARE_ENV_VAR_BOOL(MIOPEN_DEBUG_CONV_HIP_WINOGRAD_F2X3)
+
+namespace miopen {
+namespace solver {
+namespace conv {
+
+using ProblemDescription = miopen::conv::ProblemDescription;
+
+namespace {
+
+constexpr int xform_tiles = 16; // 4x4 transformed tile positions
+constexpr size_t block_size = 256;
+
+struct WinoF2x3Sizes
+{
+    int N, C, K, H, W, TH, TW;
+    long long P;
+    size_t u_elems, v_elems, m_elems;
+    // The workspace holds U, V and M in the tensors' type.
+    bool half;
+    size_t elem_bytes;
+
+    explicit WinoF2x3Sizes(const ProblemDescription& problem)
+        // Backward data runs as a forward pass from dy (problem "in") to dx
+        // (problem "out"), so in/out channels are read the same way for both.
+        : N(static_cast<int>(problem.GetBatchSize())),
+          C(static_cast<int>(problem.GetInChannels())),
+          K(static_cast<int>(problem.GetOutChannels())),
+          H(static_cast<int>(problem.GetOutHeight())),
+          W(static_cast<int>(problem.GetOutWidth())),
+          TH((H + 1) / 2),
+          TW((W + 1) / 2),
+          P(static_cast<long long>(N) * TH * TW),
+          u_elems(static_cast<size_t>(xform_tiles) * K * C),
+          v_elems(static_cast<size_t>(xform_tiles) * C * P),
+          m_elems(static_cast<size_t>(xform_tiles) * K * P),
+          half(problem.IsFp16()),
+          elem_bytes(half ? 2 : sizeof(float))
+    {
+    }
+
+    size_t WorkspaceBytes() const { return (u_elems + v_elems + m_elems) * elem_bytes; }
+};
+
+KernelInfo MakeKernel(const ExecutionContext& ctx, const std::string& name, size_t threads)
+{
+    KernelInfo k;
+    k.kernel_file  = "winograd_f2x3_xform.cpp";
+    k.kernel_name  = name;
+    k.comp_options = ctx.general_compile_options;
+    k.l_wk         = {block_size, 1, 1};
+    k.g_wk         = {(threads + block_size - 1) / block_size * block_size, 1, 1};
+    return k;
+}
