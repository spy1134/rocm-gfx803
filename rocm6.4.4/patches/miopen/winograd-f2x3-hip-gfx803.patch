+} // namespace
+
+bool ConvHipWinogradF2x3::IsApplicable(const ExecutionContext& ctx,
+                                       const ProblemDescription& problem) const
+{
+#if MIOPEN_BACKEND_HIP && MIOPEN_USE_ROCBLAS
+    if(env::disabled(MIOPEN_DEBUG_CONV_HIP_WINOGRAD_F2X3))
+        return false;
+    if(!ctx.use_hip_kernels)
+        return false;
+    // Validated only on gfx803, where MIOpen's own Winograd kernels are not
+    // usable: the binary ones corrupt memory and the multi-pass ones are gfx9
+    // assembly.
+    if(!StartsWith(ctx.GetStream().GetDeviceName(), "gfx8"))
+        return false;
+    if(!problem.Is2d() || !(problem.IsFp32() || problem.IsFp16()) || problem.IsTensorsCasted())
+        return false;
+    if(!(problem.IsDirectionForward() || problem.IsDirectionBackwardData()))
+        return false;
+    if(!problem.IsLayoutDefault())
+        return false;
+    if(!(problem.GetIn().IsPacked() && problem.GetWeights().IsPacked() &&
+         problem.GetOut().IsPacked()))
+        return false;
+    if(problem.GetConv().mode != miopenConvolution || problem.GetGroupCount() != 1)
+        return false;
+    if(problem.GetWeightsHeight() != 3 || problem.GetWeightsWidth() != 3)
+        return false;
+    if(problem.GetPadH() != 1 || problem.GetPadW() != 1)
+        return false;
+    if(problem.GetKernelStrideH() != 1 || problem.GetKernelStrideW() != 1)
+        return false;
+    if(problem.GetDilationH() != 1 || problem.GetDilationW() != 1)
+        return false;
+    if(problem.GetInHeight() != problem.GetOutHeight() ||
+       problem.GetInWidth() != problem.GetOutWidth())
+        return false;
+    if(problem.GetAlphaBetaCase() != DEFAULT)
+        return false;
+
+    // rocBLAS takes m, n, k and the leading dimensions as int.
+    const WinoF2x3Sizes s(problem);
+    constexpr long long int_max = 0x7fffffffLL;
+    if(s.P > int_max || static_cast<long long>(s.C) * s.P > int_max ||
+       static_cast<long long>(s.K) * s.P > int_max)
+        return false;
+    return true;
+#else
+    std::ignore = ctx;
+    std::ignore = problem;
+    return false;
+#endif
+}
+
+size_t ConvHipWinogradF2x3::GetWorkspaceSize(const ExecutionContext&,
+                                             const ProblemDescription& problem) const
+{
+    return WinoF2x3Sizes(problem).WorkspaceBytes();
+}
+
+ConvSolution ConvHipWinogradF2x3::GetSolution(const ExecutionContext& ctx,
+                                              const ProblemDescription& problem) const
+{
+    ConvSolution result;
+    const WinoF2x3Sizes s(problem);
+    result.workspace_sz = s.WorkspaceBytes();
+
+    const std::string suffix = s.half ? "Half" : "";
+    result.construction_params.push_back(MakeKernel(
+        ctx, "miopenWinogradF2x3XformFilter" + suffix, static_cast<size_t>(s.K) * s.C));
+    result.construction_params.push_back(
+        MakeKernel(ctx, "miopenWinogradF2x3XformIn" + suffix, static_cast<size_t>(s.C) * s.P));
+    result.construction_params.push_back(
+        MakeKernel(ctx, "miopenWinogradF2x3XformOut" + suffix, static_cast<size_t>(s.K) * s.P));
+
+#if MIOPEN_BACKEND_HIP && MIOPEN_USE_ROCBLAS
+    const int mirror = problem.IsDirectionBackwardData() ? 1 : 0;
+    const int P      = static_cast<int>(s.P);
+    // M[t] (K x P) = U[t] (K x C) * V[t] (C x P), row-major, t = 0..15. For
+    // fp16, MIOpen's rocBLAS call accumulates in fp32.
+    const GemmDescriptor gemm{false,
+                              false,
+                              false,
+                              s.K,
+                              P,
+                              s.C,
+                              s.C,
+                              P,
+                              P,
+                              xform_tiles,
+                              static_cast<long long>(s.K) * s.C,
+                              static_cast<long long>(s.C) * P,
+                              static_cast<long long>(s.K) * P,
+                              1.0f,
+                              0.0f,
+                              s.half ? miopenHalf : miopenFloat,
+                              problem.GetConv().attribute.deterministic};
+    const size_t u_off = 0;
+    const size_t v_off = s.u_elems;
+    const size_t m_off = s.u_elems + s.v_elems;
+
+    result.invoker_factory = [=](const std::vector<Kernel>& kernels) {
+        return [=](const Handle& handle, const AnyInvokeParams& primitive_parameters) {
+            const auto& data_ctx = primitive_parameters.CastTo<miopen::conv::DataInvokeParams>();
+            const auto& tensors  = data_ctx.tensors;
+            if(data_ctx.workSpace == nullptr || data_ctx.workSpaceSize < s.WorkspaceBytes())
+                MIOPEN_THROW(miopenStatusBadParm, "ConvHipWinogradF2x3: workspace too small");
+            // Offsets are in elements of the workspace's type.
+            char* ws_bytes = static_cast<char*>(data_ctx.workSpace);
+            auto ws_at     = [&](size_t off) { return static_cast<void*>(ws_bytes + off * s.elem_bytes); };
+
+            // With profiling on, each launch resets the handle's kernel time,
+            // so the first three steps are summed and added to the last one.
+            float elapsed = 0.0f;
+            auto step_done = [&](bool last) {
+                if(!handle.IsProfilingEnabled())
+                    return;
+                if(last)
+                    handle.AccumKernelTime(elapsed);
+                else
+                    elapsed += handle.GetKernelTime();
+            };
+
+            handle.Run(kernels[0])(tensors.w, ws_at(u_off), s.K, s.C, mirror);
+            step_done(false);
+            handle.Run(kernels[1])(tensors.in, ws_at(v_off), s.N, s.C, s.H, s.W, s.TH, s.TW);
+            step_done(false);
+            const auto status = CallGemmStridedBatched(handle,
+                                                       gemm,
+                                                       data_ctx.workSpace,
+                                                       u_off,
+                                                       data_ctx.workSpace,
+                                                       v_off,
+                                                       data_ctx.workSpace,
+                                                       m_off,
+                                                       GemmBackend_t::rocblas);
+            if(status != miopenStatusSuccess)
+                MIOPEN_THROW(status, "ConvHipWinogradF2x3: GEMM failed");
+            step_done(false);
+            handle.Run(kernels[2])(ws_at(m_off), tensors.out, s.N, s.K, s.H, s.W, s.TH, s.TW);
+            step_done(true);
+        };
+    };
+#endif
+    return result;
+}
