 // ================================================================================================
+// gfx7/gfx8 only: publish one PM4 ACQUIRE_MEM in its own AQL ring slot, ahead of the packet the
+// caller is about to write.
+//
+// The LLVM memory model for GFX6-GFX9 and this file's own header comment both assume that the
+// packet processor invalidates the per-CU vector L1, the scalar K$ and the I$ at the start of
+// every dispatch whose acquire scope is agent or wider, and writes back and invalidates L2 at
+// system scope. On gfx803 with MEC firmware 0x2da that does not happen: a kernel reading a page
+// that a copy kernel just refilled through L2 is served the previous contents of that page out
+// of its CU's L1 whenever the same CU read the page before. ROCr's fragment heap hands a freed
+// page straight back to the next allocation of the same size, so any hipFree followed by a
+// hipMalloc of a small buffer sets this up.
+//
+// CP_COHER_CNTL asks for the vector L1 (TCL1) and the scalar cache (SH_KCACHE) only. The vector L1
+// is the cache that serves stale lines; invalidating it alone cures the probe, and adding the
+// scalar cache costs about half a percent. The L2 pair (TC, TC_WB) and the instruction cache are
+// left out: they added roughly five percent to decode time and are not needed by shader copies,
+// which write through L2; ROCr invalidates the instruction cache itself when a code object loads.
+//
+// The slot follows the gfx8 PM4-in-an-AQL-slot protocol that ROCr's AqlQueue::ExecutePM4 uses:
+// raw PM4, a NOP pad, and a trailing RELEASE_MEM with EVENT_INDEX(AQL) that retires the slot.
+// dword 0 is stored last with release semantics, so the CP never sees a half-written packet.
+// The slot rings no doorbell: the packet the caller writes next sits at a higher ring index and
+// its doorbell commits this slot as well. ACQUIRE_MEM stalls the CP until the cache action is
+// done, so the following packet cannot launch before it.
+bool VirtualGPU::insertTcFence() {
+  if (!CLR_GFX8_TC_INVALIDATE || dev().isa().versionMajor() > 8) return true;
+
+  constexpr uint32_t kSlotDwords = 16;
+  constexpr uint32_t kPm4Type3 = 3u << 30;
+  // ROCr's PM4_HDR sets SHADER_TYPE only for gfxip 7.
+  const uint32_t shaderType = (dev().isa().versionMajor() == 7) ? (1u << 1) : 0u;
+  const uint32_t acquireMemHdr = kPm4Type3 | ((7u - 2u) << 16) | (0x58u << 8) | shaderType;
+  const uint32_t nopHdr = kPm4Type3 | ((2u - 2u) << 16) | (0x10u << 8) | shaderType;
+  const uint32_t releaseMemHdr = kPm4Type3 | ((7u - 2u) << 16) | (0x49u << 8) | shaderType;
+  [[maybe_unused]] constexpr uint32_t kTcWbActionEna = 1u << 18;
+  constexpr uint32_t kTcl1ActionEna = 1u << 22;
+  [[maybe_unused]] constexpr uint32_t kTcActionEna = 1u << 23;
+  constexpr uint32_t kShKcacheActionEna = 1u << 27;
+  [[maybe_unused]] constexpr uint32_t kShIcacheActionEna = 1u << 29;
+  constexpr uint32_t kReleaseEventIndexAql = 7u << 8;
+
+  uint32_t slot[kSlotDwords] = {0};
+  slot[0] = acquireMemHdr;
+  slot[1] = kTcl1ActionEna | kShKcacheActionEna;
+  // CP_COHER_CNTL 0x08400000
+  slot[2] = 0xFFFFFFFFu;  // COHER_SIZE, in 256-byte granules
+  slot[3] = 0xFFu;        // COHER_SIZE_HI: whole address space
+  slot[6] = 0x0000000Au;  // poll interval, as gfx_v8_0_emit_mem_sync_compute uses
+  slot[7] = nopHdr;
+  slot[9] = releaseMemHdr;
+  slot[10] = kReleaseEventIndexAql;
+
+  const uint32_t queueMask = gpu_queue_->size - 1;
+  const uint64_t index = hsa_queue_add_write_index_screlease(gpu_queue_, 1);
+  while ((index - hsa_queue_load_read_index_scacquire(gpu_queue_)) >= queueMask) {
+    amd::Os::yield();
+  }
+
+  uint32_t* dst = reinterpret_cast<uint32_t*>(gpu_queue_->base_address) +
+                  ((index & queueMask) * kSlotDwords);
+  for (uint32_t i = 1; i < kSlotDwords; ++i) dst[i] = slot[i];
+  __atomic_store_n(dst, slot[0], __ATOMIC_RELEASE);
+  return true;
+}
