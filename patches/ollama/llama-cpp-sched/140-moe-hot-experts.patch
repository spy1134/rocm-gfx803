+// A single token reads 8 of a layer's 256 experts or so, and routing is skewed: device memory left over after
+// the dense weights serves more of those reads when it holds the most-used experts of every layer than when it
+// holds every expert of a few layers. The list at path names (layer, expert) pairs, most-used first; they are
+// copied from the model file until bytes are used up (0: all of them).
+static void llama_moe_hot_load(llama_model & model, llama_model_loader & ml, const char * path, size_t bytes) {
+    if (path == nullptr) {
+        return;
+    }
+    const size_t budget = bytes ? bytes : SIZE_MAX;
+
+    const int     n_layer  = (int) model.layers.size();
+    const int64_t n_expert = model.hparams.n_expert;
+
+    ggml_backend_dev_t dev = nullptr;
+    for (const auto & d : model.devices) {
+        if (!d.is_meta && ggml_backend_dev_type(d.dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+            dev = d.dev;
+            break;
+        }
+    }
+    if (dev == nullptr || n_expert == 0) {
+        LLAMA_LOG_WARN("%s: hot experts need a GPU and a MoE model, %s ignored\n", __func__, path);
+        return;
+    }
+
+    // bytes of one expert of a layer, 0 when the layer's experts are not in host memory
+    std::vector<size_t> expert_bytes(n_layer, 0);
+    for (int il = 0; il < n_layer; ++il) {
+        const llama_layer & l = model.layers[il];
+        if (!l.ffn_down_exps || !l.ffn_down_exps->buffer || !ggml_backend_buffer_is_host(l.ffn_down_exps->buffer)) {
+            continue;
+        }
+        for (const ggml_tensor * t : {l.ffn_up_exps, l.ffn_gate_exps, l.ffn_gate_up_exps, l.ffn_down_exps}) {
+            expert_bytes[il] += t ? t->nb[2] : 0;
+        }
+    }
+
+    std::vector<std::vector<int32_t>> hot(n_layer);
+    {
+        FILE * f = fopen(path, "r");
+        if (f == nullptr) {
+            throw std::runtime_error(format("cannot open the hot expert list %s", path));
+        }
+        std::vector<std::vector<bool>> seen(n_layer, std::vector<bool>(n_expert, false));
+        char line[256];
+        size_t used = 0;
+        while (fgets(line, sizeof(line), f)) {
+            int il, ie;
+            if (sscanf(line, "%d %d", &il, &ie) != 2 || il < 0 || il >= n_layer || ie < 0 || ie >= n_expert ||
+                expert_bytes[il] == 0 || seen[il][ie] || used + expert_bytes[il] > budget) {
+                continue;
+            }
+            seen[il][ie] = true;
+            hot[il].push_back(ie);
+            used += expert_bytes[il];
+        }
+        fclose(f);
+    }
+
+    int n_tensors = 0;
+    for (int il = 0; il < n_layer; ++il) {
+        if (!hot[il].empty()) {
+            std::sort(hot[il].begin(), hot[il].end());
+            n_tensors += 6;
+        }
+    }
+    if (n_tensors == 0) {
+        return;
+    }
+
+    ggml_init_params ip = { (size_t) n_tensors*ggml_tensor_overhead(), nullptr, true };
+    model.moe_hot_ctx.reset(ggml_init(ip));
+    ggml_context * ctx = model.moe_hot_ctx.get();
+    model.moe_hot.assign(n_layer, {});
+
+    auto slots_like = [&](const ggml_tensor * src, int64_t n_slot) -> ggml_tensor * {
+        return src ? ggml_new_tensor_3d(ctx, src->type, src->ne[0], src->ne[1], n_slot) : nullptr;
+    };
+    for (int il = 0; il < n_layer; ++il) {
+        if (hot[il].empty()) {
+            continue;
+        }
+        const llama_layer & l = model.layers[il];
+        llama_moe_hot_layer & h = model.moe_hot[il];
+        const int64_t n_slot = hot[il].size();
+        h.up      = slots_like(l.ffn_up_exps,      n_slot);
+        h.gate    = slots_like(l.ffn_gate_exps,    n_slot);
+        h.gate_up = slots_like(l.ffn_gate_up_exps, n_slot);
+        h.down    = slots_like(l.ffn_down_exps,    n_slot);
+        h.slot_of = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, n_expert);
+        h.cold_id = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, n_expert);
+    }
+
+    model.moe_hot_buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_dev_buffer_type(dev)));
+    if (!model.moe_hot_buf) {
+        size_t want = 0;
+        for (int il = 0; il < n_layer; ++il) {
+            want += expert_bytes[il]*hot[il].size();
+        }
+        LLAMA_LOG_WARN("%s: cannot allocate %.0f MiB for the hot experts in %s, they stay on the CPU\n",
+            __func__, want/1024.0/1024.0, ggml_backend_dev_name(dev));
+        model.moe_hot.clear();
+        model.moe_hot_ctx.reset();
+        return;
+    }
+    ggml_backend_buffer_set_usage(model.moe_hot_buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    // read from the file rather than from the loaded tensors, which a host buffer may hold repacked
+    std::vector<uint8_t> tmp;
+    auto fill = [&](ggml_tensor * dst, const ggml_tensor * src, const std::vector<int32_t> & experts) {
+        if (dst == nullptr) {
+            return;
+        }
+        const auto * w = ml.get_weight(ggml_get_name(src));
+        if (w == nullptr) {
+            throw std::runtime_error(format("hot experts: %s is not in the model file", ggml_get_name(src)));
+        }
+        llama_file * file = ml.files.at(w->idx).get();
+        const size_t n = src->nb[2];
+        tmp.resize(n);
+        for (size_t s = 0; s < experts.size(); ++s) {
+            file->seek(w->offs + experts[s]*n, SEEK_SET);
+            file->read_raw(tmp.data(), n);
+            ggml_backend_tensor_set(dst, tmp.data(), s*dst->nb[2], n);
+        }
+    };
+    size_t n_hot = 0;
+    int n_layers_hot = 0;
+    for (int il = 0; il < n_layer; ++il) {
+        if (hot[il].empty()) {
+            continue;
+        }
+        const llama_layer & l = model.layers[il];
+        llama_moe_hot_layer & h = model.moe_hot[il];
+        fill(h.up,      l.ffn_up_exps,      hot[il]);
+        fill(h.gate,    l.ffn_gate_exps,    hot[il]);
+        fill(h.gate_up, l.ffn_gate_up_exps, hot[il]);
+        fill(h.down,    l.ffn_down_exps,    hot[il]);
+        std::vector<int32_t> slot_of(n_expert, -1);
+        std::vector<int32_t> cold_id(n_expert);
+        for (size_t s = 0; s < hot[il].size(); ++s) {
+            slot_of[hot[il][s]] = (int32_t) s;
+        }
+        for (int64_t e = 0; e < n_expert; ++e) {
+            cold_id[e] = slot_of[e] < 0 ? (int32_t) e : -1;
+        }
+        ggml_backend_tensor_set(h.slot_of, slot_of.data(), 0, n_expert*sizeof(int32_t));
+        ggml_backend_tensor_set(h.cold_id, cold_id.data(), 0, n_expert*sizeof(int32_t));
+        n_hot += hot[il].size();
+        n_layers_hot++;
+    }
+    LLAMA_LOG_INFO("%s: %zu hot experts of %d layers in %s, %.2f MiB (%s)\n", __func__, n_hot, n_layers_hot,
+        ggml_backend_dev_name(dev), ggml_backend_buffer_get_size(model.moe_hot_buf.get())/1024.0/1024.0, path);
+}
