+// Runs before ggml_cuda_try_fuse for every node. Returns true when the node is a recurrent-state
+// GET_ROWS that is not run because the GATED_DELTA_NET reading it reads the cache row itself.
+static bool ggml_cuda_try_defer_state_rows(ggml_backend_cuda_context * ctx, ggml_cgraph * cgraph, int i, int * skip) {
+    *skip = 0;
+    static const bool disable_fusion = getenv("GGML_CUDA_DISABLE_FUSION") != nullptr && std::atoi(getenv("GGML_CUDA_DISABLE_FUSION"));
+    if (disable_fusion) {
+        return false;
+    }
+
+    const ggml_tensor * node = cgraph->nodes[i];
+    if (node->op != GGML_OP_GET_ROWS || ctx->curr_stream_no != 0 || !ctx->stream_context().concurrent_events.empty()) {
+        return false;
+    }
+    if (ggml_cuda_try_defer_gdn_state(ctx, cgraph, i)) {
+        return true;
+    }
+    return false;
+}
