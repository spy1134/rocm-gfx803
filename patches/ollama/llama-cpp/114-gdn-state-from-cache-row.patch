+// A GET_ROWS that copies one recurrent-state row out of its cache for one sequence and is read, through
+// a RESHAPE, only by the first later node of type consumer_op that uses it. Returns that node's index or
+// -1. What lies between the two is for the caller to check.
+static int ggml_cuda_match_state_rows(const ggml_cgraph * cgraph, int i, ggml_op consumer_op,
+        const ggml_tensor ** reshape_out) {
+    const ggml_tensor * rows = cgraph->nodes[i];
+    const ggml_tensor * src  = rows->src[0];
+    const ggml_tensor * ids  = rows->src[1];
+    if (rows->op != GGML_OP_GET_ROWS || rows->type != GGML_TYPE_F32 || src->type != GGML_TYPE_F32 ||
+            ids->type != GGML_TYPE_I32 || src->nb[0] != sizeof(float) || !ggml_is_contiguous(rows) ||
+            rows->ne[0] != src->ne[0] || ggml_nrows(rows) != 1 || ggml_nelements(ids) != 1 ||
+            (rows->flags & GGML_TENSOR_FLAG_OUTPUT) || ggml_cuda_node_use_count(cgraph, rows) != 1) {
+        return -1;
+    }
+
+    const ggml_tensor * reshape = nullptr;
+    int j = i + 1;
+    for (; j < cgraph->n_nodes && reshape == nullptr; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->src[0] == rows) {
+            reshape = n;
+        }
+    }
+    if (reshape == nullptr || reshape->op != GGML_OP_RESHAPE || reshape->view_src != rows ||
+            (reshape->flags & GGML_TENSOR_FLAG_OUTPUT) || ggml_cuda_node_use_count(cgraph, reshape) != 1) {
+        return -1;
+    }
+
+    for (; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->src[0] == reshape || n->src[1] == reshape || (consumer_op == GGML_OP_GATED_DELTA_NET && n->src[5] == reshape)) {
+            break;
+        }
+    }
+    if (j == cgraph->n_nodes || cgraph->nodes[j]->op != consumer_op) {
+        return -1;
+    }
+    *reshape_out = reshape;
+    return j;
+}
+
+// true when no node in (i0, i1) other than those in skip writes the given bytes; with reads, also none
+// reads them (needed when a store to them moves later)
+static bool ggml_cuda_bytes_untouched(const ggml_cgraph * cgraph, int i0, int i1, const void * cache, size_t nbytes,
+        bool reads, std::initializer_list<const ggml_tensor *> skip) {
+    for (int j = i0 + 1; j < i1; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n) || std::find(skip.begin(), skip.end(), n) != skip.end()) {
+            continue;
+        }
+        if (ggml_cuda_bytes_overlap(n->data, ggml_nbytes(n), cache, nbytes)) {
+            return false;
+        }
+        if (reads) {
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                const ggml_tensor * t = n->src[s];
+                if (t != nullptr && std::find(skip.begin(), skip.end(), t) == skip.end() &&
+                        ggml_cuda_bytes_overlap(t->data, ggml_nbytes(t), cache, nbytes)) {
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+static bool ggml_cuda_try_defer_gdn_state(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * reshape = nullptr;
+    const int gdn_idx = ggml_cuda_match_state_rows(cgraph, i, GGML_OP_GATED_DELTA_NET, &reshape);
+    if (gdn_idx < 0) {
+        return false;
+    }
+    const ggml_tensor * rows = cgraph->nodes[i];
+    const ggml_tensor * gdn  = cgraph->nodes[gdn_idx];
+    if (gdn->src[5] != reshape || !ggml_cuda_gated_delta_net_state_from_rows_ok(gdn) ||
+            ggml_nelements(reshape) != ggml_nelements(gdn->src[5])) {
+        return false;
+    }
+    const ggml_tensor * src   = rows->src[0];
+    const ggml_tensor * cache = src->view_src ? src->view_src : src;
+    const ggml_tensor * ids   = rows->src[1];
+    // the state and the row ids are read when the GDN runs, so neither may change before it
+    if (!ggml_cuda_bytes_untouched(cgraph, i, gdn_idx, cache->data, ggml_nbytes(cache), false, {}) ||
+            !ggml_cuda_bytes_untouched(cgraph, i, gdn_idx, ids->data, ggml_nbytes(ids), false, {})) {
+        return false;
+    }
+    ctx->deferred_state_rows.push_back({ rows, (const float *) src->data, (const int32_t *) rows->src[1]->data,
+                                       (int64_t) (src->nb[1] / sizeof(float)) });
+    return true;
+}
