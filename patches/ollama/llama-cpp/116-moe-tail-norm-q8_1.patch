+    const ggml_tensor * resid = ggml_cuda_other_src(add2, add1);
+    const ggml_tensor * mul_w = ggml_cuda_other_src(mul, norm);
+    if (shexp == nullptr || resid == nullptr || mul_w == nullptr || norm->src[0] != add2) {
+        return false;
+    }
