+        if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || !ggml_are_same_shape(t, moe)) {
+            return false;
+        }
+    }
+    if (mul_w->type != GGML_TYPE_F32 || !ggml_is_contiguous(mul_w) || mul_w->ne[0] != moe->ne[0] ||
+            ggml_nrows(mul_w) != 1) {
+        return false;
+    }
