+        return false;
+    }
+    const ggml_tensor * moe  = red.dst;
+    ggml_tensor *       add1 = cgraph->nodes[k];
+    ggml_tensor *       add2 = cgraph->nodes[k + 1];
+    ggml_tensor *       norm = cgraph->nodes[k + 2];
+    ggml_tensor *       mul  = cgraph->nodes[k + 3];
+
+    if (moe->ne[1] != 1 || !ggml_cuda_moe_tail_rms_norm_supported(moe->ne[0])) {
+        return false;
+    }
