 }
+
+// The end of a MoE layer at one token, in one block: the router-weighted sum of the
+// expert outputs, + shared expert, + residual (the residual stream h), then the next layer's RMS norm
+// times its weight, and that result quantized to q8_1 for the matrix-vector products that read it.
+// Each step repeats the expressions of the kernels it replaces (moe_weighted_reduction_f32, the fused
+// add, rms_norm_f32<1024, true>, quantize_q8_1) with the same per-thread element order, the same
+// block reduction and the same 32-lane quantization groups, so every value is bit-identical to
+// running those kernels one after another.
+template <int block_size>
+static __global__ void moe_tail_rms_norm_mul_q8_1_f32(
+        const float * experts, const float * expert_scale, const float * weights, const int n_expert_used,
+        const float * shexp, const float * resid, float * h, const float * mul, float * dst, void * vy,
+        const int ncols, const float eps) {
+    const int tid = threadIdx.x;
+
+    float tmp = 0.0f;
+    for (int col = tid; col < ncols; col += block_size) {
+        const float first_scale = expert_scale != nullptr ? expert_scale[0] : 1.0f;
+        float       sum         = (experts[col] * first_scale) * weights[0];
+        for (int expert = 1; expert < n_expert_used; ++expert) {
+            const float scale = expert_scale != nullptr ? expert_scale[expert] : 1.0f;
+            sum += (experts[(int64_t) expert * ncols + col] * scale) * weights[expert];
+        }
+        float xi = sum;
+        xi = xi + shexp[col];
+        xi = xi + resid[col];
+        h[col] = xi;
+        tmp += xi * xi;
+    }
+
+    extern __shared__ float s_sum[];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float mean  = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+
+    block_q8_1 * y = (block_q8_1 *) vy;
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = scale * h[col] * mul[col];
+        dst[col] = xi;
+
+        float amax = fabsf(xi);
+        float sum  = xi;
+        amax = warp_reduce_max<QK8_1>(amax);
+        sum  = warp_reduce_sum<QK8_1>(sum);
+
+        const float  d = amax / 127.0f;
+        const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+
+        const int ib  = col / QK8_1;
+        const int iqs = col % QK8_1;
+        y[ib].qs[iqs] = q;
+        if (iqs == 0) {
+            y[ib].ds = make_half2(d, sum);
+        }
+    }
+}
+
+bool ggml_cuda_moe_tail_rms_norm_supported(const int64_t ncols) {
+    // one 1024-thread block, as rms_norm_f32 uses for rows of 1024 and more; every thread runs the
+    // same number of iterations so the quantization shuffles never diverge; no q8_1 padding blocks
+    return ncols >= 1024 && ncols % 1024 == 0 && ncols % MATRIX_ROW_PADDING == 0;
+}
+
+void ggml_cuda_op_moe_tail_rms_norm_q8_1(ggml_backend_cuda_context & ctx,
+                                         const ggml_tensor *         experts,
+                                         const ggml_tensor *         expert_scale,
+                                         const ggml_tensor *         weights,
+                                         const ggml_tensor *         shexp,
+                                         const ggml_tensor *         resid,
+                                         ggml_tensor *               h,
+                                         const ggml_tensor *         rms_norm,
+                                         const ggml_tensor *         mul_w,
+                                         ggml_tensor *               dst) {
+    const int64_t ncols = h->ne[0];
+    GGML_ASSERT(ggml_cuda_moe_tail_rms_norm_supported(ncols));
+    GGML_ASSERT(ggml_nrows(h) == 1 && ggml_nrows(dst) == 1);
+    GGML_ASSERT(ctx.curr_stream_no == 0);
+
+    float eps = 0.0f;
+    memcpy(&eps, rms_norm->op_params, sizeof(float));
+
+    // the kept q8_1 copy is replaced by this one when the group is committed; freeing it before the new
+    // allocation keeps pool frees in reverse allocation order, which the VMM pool requires
+    ctx.mmvq_src1_invalidate();
+    const size_t q8_1_size = ncols * sizeof(block_q8_1) / QK8_1;
+    auto & pending = ctx.mmvq_src1_pending;
+    pending.q8_1   = std::make_unique<ggml_cuda_pool_alloc<char>>(ctx.pool(), q8_1_size);
+
+    cudaStream_t stream = ctx.stream();
+    moe_tail_rms_norm_mul_q8_1_f32<1024><<<1, 1024, 32 * sizeof(float), stream>>>(
+        (const float *) experts->data, expert_scale ? (const float *) expert_scale->data : nullptr,
+        (const float *) weights->data, (int) experts->ne[1],
+        (const float *) shexp->data, (const float *) resid->data, (float *) h->data,
+        (const float *) mul_w->data, (float *) dst->data, pending.q8_1->get(), (int) ncols, eps);
+    CUDA_CHECK(cudaGetLastError());
+
+    pending.data   = dst->data;
+    pending.nbytes = ggml_nbytes(dst);
+    std::copy(dst->ne, dst->ne + GGML_MAX_DIMS, pending.ne);
+    std::copy(dst->nb, dst->nb + GGML_MAX_DIMS, pending.nb);
+}
