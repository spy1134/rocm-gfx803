+// gfx803, tiles with one query head per K/V head (ncols2 == 1: vision encoders,
+// and text models whose GQA ratio is odd). These tiles stay on the half2 path,
+// which spills at 64 columns for every head size (head size 72: 305 VGPRs).
+// launch_fattn_tile_switch_ncols1() caps their width at
+// ggml_cuda_fattn_tile_gcn4_ncols2_1_max_ncols(); this table raises the VGPR
+// budget of the 16- and 32-column tiles to occupancy 1 where that is faster.
+// Measured on an RX 590 with 16 heads, 4096 queries x 4096 keys, f16 K/V, no
+// mask: occupancy 2 is better for head sizes 40 and 72 and is left as it is.
+// Only the occupancy differs from the table above, so the host's thread counts
+// and batch sizes stay correct.
+static constexpr __host__ __device__ uint32_t ggml_cuda_fattn_tile_get_config_amd_gcn4_ncols2_1(const int DKQ, const int DV, const int ncols) {
+    GGML_CUDA_FATTN_TILE_CONFIG_CASE( 64,  64, 16, 256, 1, 128,  64)
+    GGML_CUDA_FATTN_TILE_CONFIG_CASE( 64,  64, 32, 256, 1,  64,  64)
+
+    GGML_CUDA_FATTN_TILE_CONFIG_CASE( 80,  80, 16, 256, 1,  32,  40)
+    GGML_CUDA_FATTN_TILE_CONFIG_CASE( 80,  80, 32, 256, 1,  32,  40)
+
+    GGML_CUDA_FATTN_TILE_CONFIG_CASE( 96,  96, 16, 256, 1,  32,  48)
+    GGML_CUDA_FATTN_TILE_CONFIG_CASE( 96,  96, 32, 256, 1,  32,  48)
+
+    GGML_CUDA_FATTN_TILE_CONFIG_CASE(112, 112, 16, 256, 1,  32,  56)
+
+    GGML_CUDA_FATTN_TILE_CONFIG_CASE(128, 128, 16, 256, 1,  64, 128)
+
+    GGML_CUDA_FATTN_TILE_CONFIG_CASE(256, 256, 16, 256, 1,  32, 128)
+
+    return ggml_cuda_fattn_tile_get_config_amd_gcn4(DKQ, DV, ncols);
+}
+
+// Widest ncols2 == 1 tile on gfx803, by head size. Time per call against the
+// 64-column tile (RX 590, same shapes as above): 0.27x for head size 40, 0.18x
+// for 64, 80 and 96 at 32 columns; 0.18x for 72, 0.25x for 112 and 0.28x for 128
+// at 16 columns (128 at 32 columns: 0.55x). Head size 256, which has no
+// 64-column tile: 0.51x of its 32-column tile at 16 columns.
+static constexpr __host__ int ggml_cuda_fattn_tile_gcn4_ncols2_1_max_ncols(const int DKQ) {
+    return DKQ == 40 || DKQ == 64 || DKQ == 80 || DKQ == 96 ? 32 : 16;
+}
