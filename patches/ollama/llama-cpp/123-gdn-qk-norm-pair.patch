@@ -4320,6 +4320,68 @@
     return false;
 }
 
+// The two RMS_NORM -> SCALE pairs that normalize the q and k heads of a Gated DeltaNet layer (the l2 norm of
+// build_gdn_l2_norm), both taken by the fused rms_norm * scale kernel and separated only by views: one
+// launch runs both, each block on its own row with the single-pair kernel's body.
+struct ggml_cuda_rms_norm_scale_pair_match {
+    int           second = -1;
+    ggml_tensor * norm0  = nullptr;
+    ggml_tensor * scale0 = nullptr;
+    ggml_tensor * norm1  = nullptr;
+    ggml_tensor * scale1 = nullptr;
+};
+
+static bool ggml_cuda_match_rms_norm_scale_pair(const ggml_cgraph * cgraph, int i, ggml_cuda_rms_norm_scale_pair_match & m) {
+    if (i + 1 >= cgraph->n_nodes || cgraph->nodes[i]->op != GGML_OP_RMS_NORM ||
+            !ggml_cuda_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_SCALE }, {})) {
+        return false;
+    }
+    int j = i + 2;
+    while (j < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[j])) {
+        ++j;
+    }
+    if (j + 1 >= cgraph->n_nodes || cgraph->nodes[j]->op != GGML_OP_RMS_NORM ||
+            !ggml_cuda_can_fuse(cgraph, j, { GGML_OP_RMS_NORM, GGML_OP_SCALE }, {})) {
+        return false;
+    }
+    ggml_tensor * norm0  = cgraph->nodes[i];
+    ggml_tensor * scale0 = cgraph->nodes[i + 1];
+    ggml_tensor * norm1  = cgraph->nodes[j];
+    ggml_tensor * scale1 = cgraph->nodes[j + 1];
+    const ggml_tensor * x0 = norm0->src[0];
+    const ggml_tensor * x1 = norm1->src[0];
+    if (x0->type != GGML_TYPE_F32 || x1->type != GGML_TYPE_F32 || x0->nb[0] != sizeof(float) || x0->ne[2] != 1 || x0->ne[3] != 1 ||
+            !ggml_are_same_shape(x0, x1) || !ggml_are_same_stride(x0, x1) ||
+            memcmp(norm0->op_params, norm1->op_params, sizeof(float)) != 0) {
+        return false;
+    }
+    for (const ggml_tensor * s : { scale0, scale1 }) {
+        if (s->type != GGML_TYPE_F32 || !ggml_is_contiguous(s) || !ggml_are_same_shape(s, x0)) {
+            return false;
+        }
+    }
+    // each pair's output is written while the other pair's input is still read
+    if (ggml_cuda_bytes_overlap(scale0, x1) || ggml_cuda_bytes_overlap(scale1, x0) || ggml_cuda_bytes_overlap(scale0, scale1)) {
+        return false;
+    }
+    m.second = j + 1;
+    m.norm0  = norm0;
+    m.scale0 = scale0;
+    m.norm1  = norm1;
+    m.scale1 = scale1;
+    return true;
+}
+
+static bool ggml_cuda_try_rms_norm_scale_pair(ggml_backend_cuda_context * ctx, ggml_cgraph * cgraph, int i, int * skip) {
+    ggml_cuda_rms_norm_scale_pair_match m;
+    if (!ggml_cuda_match_rms_norm_scale_pair(cgraph, i, m)) {
+        return false;
+    }
+    ggml_cuda_op_rms_norm_scale_pair(*ctx, m.norm0, m.scale0, m.norm1, m.scale1);
+    *skip = m.second - i;
+    return true;
+}
+
 // Runs before ggml_cuda_try_fuse for every node. Returns true when the node was handled here: a node that is
 // not run because a fused kernel later in the graph computes it, or the node that runs that kernel (then *skip
 // is the number of following nodes it covered). One token, main stream only.
@@ -4335,6 +4397,9 @@
     if (ggml_cuda_try_gated_norm(ctx, cgraph, i, skip)) {
         return true;
     }
+    if (ggml_cuda_try_rms_norm_scale_pair(ctx, cgraph, i, skip)) {
+        return true;
+    }
     return false;
 }
 
