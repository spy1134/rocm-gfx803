+// rms_norm_f32<block_size, false, false, true> over two tensors of the same shape and strides in one launch:
+// blockIdx.z picks the tensor, so every block runs the body of the single-tensor kernel on its own row.
+template <int block_size>
+static __global__ void rms_norm_scale_pair_f32(const float * x0,
+                                               const float * x1,
+                                               float *       dst0,
+                                               float *       dst1,
+                                               const int     ncols,
+                                               const int64_t stride_row,
+                                               const int64_t stride_channel,
+                                               const int64_t stride_sample,
+                                               const int     nsamples,
+                                               const float   eps,
+                                               const float   scale_out0,
+                                               const float   scale_out1) {
+    ggml_cuda_pdl_lc();
+    const int nrows     = gridDim.x;
+    const int nchannels = gridDim.y;
+
+    const bool second  = blockIdx.z >= nsamples;
+    const int  row     = blockIdx.x;
+    const int  channel = blockIdx.y;
+    const int  sample  = blockIdx.z - (second ? nsamples : 0);
+    const int  tid     = threadIdx.x;
+
+    const float * x         = second ? x1 : x0;
+    float *       dst       = second ? dst1 : dst0;
+    const float   scale_out = second ? scale_out1 : scale_out0;
+
+    x   += sample*stride_sample + channel*stride_channel + row*stride_row;
+    dst += ((sample*nchannels + channel)*nrows + row)*ncols;
+
+    float tmp = 0.0f; // partial sum for thread in warp
+
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = x[col];
+        tmp += xi * xi;
+    }
+
+    // sum up partial sums
+    extern __shared__ float s_sum[];
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+
+    const float mean = tmp / ncols;
+    const float scale = rsqrtf(mean + eps);
+
+    for (int col = tid; col < ncols; col += block_size) {
+        dst[col] = scale_out * (scale * x[col]);
+    }
+}
+
 template <bool do_scale = false>
 static void rms_norm_f32_cuda(
         const float * x, float * dst, const int ncols, const int nrows, const int nchannels, const int nsamples,
@@ -927,3 +979,49 @@
     std::copy(mmvq_src1->ne, mmvq_src1->ne + GGML_MAX_DIMS, pending.ne);
     std::copy(mmvq_src1->nb, mmvq_src1->nb + GGML_MAX_DIMS, pending.nb);
 }
+
+void ggml_cuda_op_rms_norm_scale_pair(ggml_backend_cuda_context & ctx, const ggml_tensor * rms_norm0, ggml_tensor * scale0,
+                                      const ggml_tensor * rms_norm1, ggml_tensor * scale1) {
+    const ggml_tensor * src0 = rms_norm0->src[0];
+    const ggml_tensor * src1 = rms_norm1->src[0];
+
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(scale0->type == GGML_TYPE_F32 && scale1->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_are_same_shape(src0, src1) && ggml_are_same_stride(src0, src1));
+
+    float eps;
+    memcpy(&eps, rms_norm0->op_params, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    float scale_out0;
+    float scale_out1;
+    memcpy(&scale_out0, (const float *) scale0->op_params + 0, sizeof(float));
+    memcpy(&scale_out1, (const float *) scale1->op_params + 0, sizeof(float));
+
+    const size_t ts0 = ggml_type_size(src0->type);
+    GGML_ASSERT(src0->nb[0] == ts0);
+    const int64_t s01 = src0->nb[1] / ts0;
+    const int64_t s02 = src0->nb[2] / ts0;
+    const int64_t s03 = src0->nb[3] / ts0;
+
+    const int ncols    = src0->ne[0];
+    const int nsamples = src0->ne[3];
+
+    const float * x0 = (const float *) src0->data;
+    const float * x1 = (const float *) src1->data;
+    float *     dst0 = (float *) scale0->data;
+    float *     dst1 = (float *) scale1->data;
+
+    const dim3 blocks_num(src0->ne[1], src0->ne[2], 2 * nsamples);
+    if (ncols < 1024) {
+        const dim3 block_dims(256, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params = {blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float): 0, ctx.stream()};
+        ggml_cuda_kernel_launch(rms_norm_scale_pair_f32<256>, launch_params,
+            x0, x1, dst0, dst1, ncols, s01, s02, s03, nsamples, eps, scale_out0, scale_out1);
+    } else {
+        const dim3 block_dims(1024, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params = {blocks_num, block_dims, block_dims.x > WARP_SIZE ? 32 * sizeof(float): 0, ctx.stream()};
+        ggml_cuda_kernel_launch(rms_norm_scale_pair_f32<1024>, launch_params,
+            x0, x1, dst0, dst1, ncols, s01, s02, s03, nsamples, eps, scale_out0, scale_out1);
+    }
+}
