+// One product of a shared-input group (ggml_cuda_try_fuse_mmvq_group): a single-token MUL_MAT that
+// mul_mat_vec_q runs with the GCN4 two-row shape, alone (n_nodes 1) or as the MUL_MAT -> RESHAPE/VIEW -> ADD
+// chain whose ADD the product performs as its bias epilogue (n_nodes 3, the conditions of
+// ggml_cuda_try_fuse_mm_reshape_add). Products that another
+// fusion takes (MUL_MAT -> ADD, the gate/up pair of a GLU) are not members: those fusions save more.
+struct ggml_cuda_mmvq_group_member {
+    ggml_tensor *       mm      = nullptr;
+    const ggml_tensor * bias    = nullptr;
+    ggml_tensor *       out     = nullptr;
+    int                 n_nodes = 0;
+};
+
+static bool ggml_cuda_match_mmvq_group_member(const ggml_cgraph * cgraph, int j, int device, ggml_cuda_mmvq_group_member & m) {
+    ggml_tensor * mm = cgraph->nodes[j];
+    if (mm->op != GGML_OP_MUL_MAT || mm->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm) ||
+            (mm->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || mm->ne[1] != 1 || mm->ne[2] != 1 || mm->ne[3] != 1) {
+        return false;
+    }
+    const ggml_tensor * src0 = mm->src[0];
+    const ggml_tensor * src1 = mm->src[1];
+    if (src0->op != GGML_OP_NONE || src0->view_src != nullptr || src0->ne[2] != 1 || src0->ne[3] != 1 ||
+            src0->nb[0] != ggml_type_size(src0->type)) {
+        return false;
+    }
+    if (src0->buffer == nullptr || ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || src1->nb[0] != sizeof(float) || src1->ne[0] != src0->ne[0] ||
+            src1->ne[1] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1) {
+        return false;
+    }
+    // the path ggml_cuda_mul_mat takes for this product must be mul_mat_vec_q
+    const int cc        = ggml_cuda_info().devices[device].cc;
+    const int warp_size = ggml_cuda_info().devices[device].warp_size;
+    if (!ggml_cuda_mmvq_group_supported(src0->type, cc)) {
+        return false;
+    }
+    if (ggml_cuda_op_mul_mat_use_fwht(mm) || ggml_cuda_should_use_mmvf(src0->type, cc, src0->ne, src0->nb, 1) ||
+            ggml_cuda_should_use_mmf(src0->type, cc, warp_size, src0->ne, src0->nb, 1, false) ||
+            !ggml_cuda_should_use_mmvq(src0->type, cc, 1)) {
+        return false;
+    }
+
+    m = {};
+    m.mm      = mm;
+    m.out     = mm;
+    m.n_nodes = 1;
+
+    if (j + 2 < cgraph->n_nodes) {
+        ggml_tensor * reshape = cgraph->nodes[j + 1];
+        ggml_tensor * add     = cgraph->nodes[j + 2];
+        if ((reshape->op == GGML_OP_RESHAPE || reshape->op == GGML_OP_VIEW) && reshape->src[0] == mm &&
+                reshape->view_src == mm && reshape->view_offs == 0 && reshape->type == mm->type &&
+                ggml_are_same_shape(reshape, mm) && ggml_are_same_stride(reshape, mm) &&
+                add->op == GGML_OP_ADD && add->type == GGML_TYPE_F32 && (add->flags & GGML_TENSOR_FLAG_COMPUTE) &&
+                ggml_are_same_shape(add->src[0], add->src[1])) {
+            const ggml_tensor * bias = ggml_cuda_other_src(add, reshape);
+            if (bias != nullptr && bias != reshape && bias->type == GGML_TYPE_F32 && ggml_is_contiguous(bias) &&
+                    ggml_is_contiguous(add) && ggml_node_has_n_uses(cgraph, j, 1) &&
+                    ggml_cuda_node_use_count(cgraph, reshape) == 1 && !(reshape->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                m.bias    = bias;
+                m.out     = add;
+                m.n_nodes = 3;
+                return true;
+            }
+        }
+    }
+
+    // a product that the MUL_MAT -> ADD bias fusion or the GLU gate/up fusion would take
+    for (int k = j + 1; k <= j + 2 && k < cgraph->n_nodes; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if ((n->op == GGML_OP_ADD || n->op == GGML_OP_GLU) && (n->src[0] == mm || n->src[1] == mm)) {
+            return false;
+        }
+    }
+    if (j + 1 < cgraph->n_nodes && cgraph->nodes[j + 1]->op == GGML_OP_GLU) {
+        return false;
+    }
+    if (j + 2 < cgraph->n_nodes && cgraph->nodes[j + 1]->op == GGML_OP_MUL_MAT && cgraph->nodes[j + 2]->op == GGML_OP_GLU) {
+        return false;
+    }
+    return true;
+}
+
+static const ggml_tensor * ggml_cuda_view_root(const ggml_tensor * t) {
+    return t->view_src ? t->view_src : t;
+}
+
+// graph_optimize, before the allocator sees the graph: moves every later group member that reads the same
+// input as a member at i to right after it, so the evaluation loop finds the group adjacent. A product
+// only reads its weights (leaf tensors) and the shared input, so it can run earlier as long as nothing
+// between the two positions writes into the input or produces an operand of the moved nodes. The
+// allocator places the moved outputs by the new order.
+static void ggml_cuda_group_shared_input_products(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph) {
+    // GGML_CUDA_GRAPH_OPT's stream interleaving of q/k/v expects the products in the builder's order
+    static const bool graph_opt = getenv("GGML_CUDA_GRAPH_OPT") != nullptr && atoi(getenv("GGML_CUDA_GRAPH_OPT")) == 1;
+    if (graph_opt) {
+        return;
+    }
+    // members of one group sit within a layer's input projections
+    constexpr int window = 96;
+    const int device = cuda_ctx->device;
+
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        ggml_cuda_mmvq_group_member head;
+        if (!ggml_cuda_match_mmvq_group_member(cgraph, i, device, head)) {
+            continue;
+        }
+        const ggml_tensor * src1      = head.mm->src[1];
+        const ggml_tensor * src1_root = ggml_cuda_view_root(src1);
+        int insert    = i + head.n_nodes;
+        int n_members = 1;
+
+        for (int j = insert; j < cgraph->n_nodes && j < i + window && n_members < GGML_CUDA_MMVQ_GROUP_MAX; ++j) {
+            const ggml_tensor * n = cgraph->nodes[j];
+            if (!ggml_cuda_is_view_or_noop(n) && ggml_cuda_view_root(n) == src1_root) {
+                break;
+            }
+            ggml_cuda_mmvq_group_member m;
+            if (n->op != GGML_OP_MUL_MAT || n->src[1] != src1 || !ggml_cuda_match_mmvq_group_member(cgraph, j, device, m)) {
+                continue;
+            }
+            bool movable = true;
+            for (int c = j; c < j + m.n_nodes && movable; ++c) {
+                for (int s = 0; s < GGML_MAX_SRC && movable; ++s) {
+                    const ggml_tensor * t = cgraph->nodes[c]->src[s];
+                    if (t == nullptr || t == src1 || (c > j && t == cgraph->nodes[c - 1])) {
+                        continue;
+                    }
+                    for (int k = insert; k < j; ++k) {
+                        if (cgraph->nodes[k] == t || cgraph->nodes[k] == ggml_cuda_view_root(t)) {
+                            movable = false;
+                            break;
+                        }
+                    }
+                }
+            }
+            if (!movable) {
+                continue;
+            }
+            std::rotate(cgraph->nodes + insert, cgraph->nodes + j, cgraph->nodes + j + m.n_nodes);
+            insert += m.n_nodes;
+            n_members++;
+            j += m.n_nodes - 1;
+        }
+        i = insert - 1;
+    }
+}
+
+// Evaluation loop: the adjacent group starting at i, launched as one mul_mat_vec_q_group.
+static int ggml_cuda_try_fuse_mmvq_group(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    if (cuda_ctx->curr_stream_no != 0) {
+        return 0;
+    }
+    const int device = cuda_ctx->device;
+
+    ggml_cuda_mmvq_group_member members[GGML_CUDA_MMVQ_GROUP_MAX];
+    if (!ggml_cuda_match_mmvq_group_member(cgraph, i, device, members[0])) {
+        return 0;
+    }
+    const ggml_tensor * src1 = members[0].mm->src[1];
+    int n = 1;
+    int k = i + members[0].n_nodes;
+    while (n < GGML_CUDA_MMVQ_GROUP_MAX && k < cgraph->n_nodes && cgraph->nodes[k]->op == GGML_OP_MUL_MAT &&
+            cgraph->nodes[k]->src[1] == src1 && ggml_cuda_match_mmvq_group_member(cgraph, k, device, members[n])) {
+        k += members[n].n_nodes;
+        n++;
+    }
+    if (n < 2) {
+        return 0;
+    }
+
+    // every output is written once by its own block range and is read by nothing in the group; the
+    // shared input is read only through its q8_1 copy, made before the launch
+    for (int a = 0; a < n; ++a) {
+        if (ggml_cuda_bytes_overlap(members[a].out, src1)) {
+            return 0;
+        }
+        for (int b = 0; b < n; ++b) {
+            if (a != b && ggml_cuda_bytes_overlap(members[a].out, members[b].out)) {
+                return 0;
+            }
+            if (members[b].bias != nullptr && ggml_cuda_bytes_overlap(members[a].out, members[b].bias)) {
+                return 0;
+            }
+        }
+    }
+
+    const ggml_tensor * src0[GGML_CUDA_MMVQ_GROUP_MAX];
+    const ggml_tensor * bias[GGML_CUDA_MMVQ_GROUP_MAX];
+    ggml_tensor *       dst[GGML_CUDA_MMVQ_GROUP_MAX];
+    for (int s = 0; s < n; ++s) {
+        src0[s] = members[s].mm->src[0];
+        bias[s] = members[s].bias;
+        dst[s]  = members[s].out;
+    }
+    ggml_cuda_mul_mat_vec_q_group(*cuda_ctx, src1, n, src0, bias, dst);
+
+    return k - 1 - i;
+}
