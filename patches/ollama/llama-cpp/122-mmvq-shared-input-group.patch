+
+// Several single-token products of one input in one launch: each block runs the two rows of the
+// mul_mat_vec_q<type, 1, ...> shape that the GCN4 table picks for these types (one warp, two rows per
+// block, no small-K variant), with the same per-lane K walk, the same warp reduction and, where the
+// segment has one, the same bias add after it. Only the grid is shared, so every output is the value
+// the separate launch writes.
+template <ggml_type type>
+static __device__ __forceinline__ void mul_mat_vec_q_group_rows(
+        const void * vx_ptr, const void * vy_ptr, const float * x_bias, float * dst_ptr,
+        const uint32_t ncols_x, const uint32_t stride_row_x, const uint32_t nrows_dst, const int row0) {
+    const void    * GGML_CUDA_RESTRICT vx  = vx_ptr;
+    const void    * GGML_CUDA_RESTRICT vy  = vy_ptr;
+    float         * GGML_CUDA_RESTRICT dst = dst_ptr;
+
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int nwarps = 1;
+    constexpr int rows_per_cuda_block = 2;
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    const     int tid = threadIdx.x;
+    const     int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
+
+    float x_biases = 0.0f;
+    if (x_bias != nullptr && threadIdx.x < rows_per_cuda_block && uint32_t(row0 + threadIdx.x) < nrows_dst) {
+        x_biases = x_bias[row0 + threadIdx.x];
+    }
+
+    float tmp[rows_per_cuda_block] = {0.0f};
+
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+    const int kbx_offset = row0*stride_row_x;
+
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (tid % (qi/vdr));
+
+#pragma unroll
+        for (int i = 0; i < rows_per_cuda_block; ++i) {
+            tmp[i] += vec_dot_q_cuda(vx, &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+        }
+    }
+
+    dst += row0;
+
+#pragma unroll
+    for (int i = 0; i < rows_per_cuda_block; ++i) {
+        tmp[i] = warp_reduce_sum<warp_size>(tmp[i]);
+
+        if (threadIdx.x == i && uint32_t(row0 + i) < nrows_dst) {
+            float result = tmp[i];
+            if (x_bias != nullptr) {
+                result += x_biases;
+            }
+            dst[i] = result;
+        }
+    }
+}
+
+__launch_bounds__(ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_group(const ggml_cuda_mmvq_group_args args, const void * vy, const uint32_t ncols_x) {
+    int s = 0;
+    while (s + 1 < args.n && blockIdx.x >= args.block_end[s]) {
+        ++s;
+    }
+    const uint32_t block0 = s == 0 ? 0 : args.block_end[s - 1];
+    const int      row0   = 2*(blockIdx.x - block0);
+
+    switch (args.type[s]) {
+        case GGML_TYPE_Q4_K:
+            mul_mat_vec_q_group_rows<GGML_TYPE_Q4_K>(args.vx[s], vy, args.bias[s], args.dst[s], ncols_x,
+                args.stride_row_x[s], args.nrows[s], row0);
+            break;
+        case GGML_TYPE_Q6_K:
+            mul_mat_vec_q_group_rows<GGML_TYPE_Q6_K>(args.vx[s], vy, args.bias[s], args.dst[s], ncols_x,
+                args.stride_row_x[s], args.nrows[s], row0);
+            break;
+        default:
+            break;
+    }
+}
+
+// The group kernel hard-codes the launch shape mul_mat_vec_q uses for these types on GCN4 at one
+// column; any other device or type keeps its own launch.
+bool ggml_cuda_mmvq_group_supported(ggml_type type, int cc) {
+    if (get_device_table_id(cc) != MMVQ_PARAMETERS_GCN4) {
+        return false;
+    }
+    if (type != GGML_TYPE_Q4_K && type != GGML_TYPE_Q6_K) {
+        return false;
+    }
+    const int nwarps = calc_nwarps(type, 1, MMVQ_PARAMETERS_GCN4);
+    return nwarps == 1 && calc_rows_per_block(1, MMVQ_PARAMETERS_GCN4, false, nwarps) == 2;
+}
+
+void ggml_cuda_mul_mat_vec_q_group(ggml_backend_cuda_context & ctx, const ggml_tensor * src1, const int n,
+        const ggml_tensor * const * src0, const ggml_tensor * const * bias, ggml_tensor * const * dst) {
+    GGML_ASSERT(n >= 1 && n <= GGML_CUDA_MMVQ_GROUP_MAX);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32 && src1->nb[0] == sizeof(float));
+    GGML_ASSERT(src1->ne[1] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1);
+
+    cudaStream_t stream = ctx.stream();
+    const int64_t ne10 = src1->ne[0];
+
+    ggml_cuda_mmvq_group_args args{};
+    args.n = n;
+    uint32_t nblocks = 0;
+    for (int s = 0; s < n; ++s) {
+        GGML_ASSERT(src0[s]->ne[0] == ne10 && src0[s]->nb[0] == ggml_type_size(src0[s]->type));
+        GGML_ASSERT(dst[s]->type == GGML_TYPE_F32 && dst[s]->ne[0] == src0[s]->ne[1] && ggml_is_contiguous(dst[s]));
+        GGML_ASSERT(bias[s] == nullptr || (bias[s]->type == GGML_TYPE_F32 && bias[s]->ne[0] == dst[s]->ne[0]));
+        args.vx[s]           = src0[s]->data;
+        args.dst[s]          = (float *) dst[s]->data;
+        args.bias[s]         = bias[s] ? (const float *) bias[s]->data : nullptr;
+        args.type[s]         = src0[s]->type;
+        args.nrows[s]        = src0[s]->ne[1];
+        args.stride_row_x[s] = src0[s]->nb[1] / ggml_type_size(src0[s]->type);
+        nblocks             += (src0[s]->ne[1] + 1) / 2;
+        args.block_end[s]    = nblocks;
+    }
+
+    // the same q8_1 copy (and the same reuse of an earlier one) as ggml_cuda_mul_mat_vec_q
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+    const size_t src1_q8_1_size = ne10_padded * sizeof(block_q8_1)/QK8_1;
+    auto & cache = ctx.mmvq_src1;
+    const bool cacheable = ctx.curr_stream_no == 0;
+    const bool cached = cacheable && cache.data == src1->data && cache.q8_1 &&
+        std::equal(cache.ne, cache.ne + GGML_MAX_DIMS, src1->ne) && std::equal(cache.nb, cache.nb + GGML_MAX_DIMS, src1->nb);
