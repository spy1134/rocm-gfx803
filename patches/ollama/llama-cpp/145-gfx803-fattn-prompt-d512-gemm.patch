diff --git a/ggml/src/ggml-cuda/fattn-gcn4-gemm.cuh b/ggml/src/ggml-cuda/fattn-gcn4-gemm.cuh
new file mode 100644
index 0000000..e6ff2f2
--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-gcn4-gemm.cuh
@@ -0,0 +1,213 @@
+#include "common.cuh"
+#include "convert.cuh"
+
+// Prompt attention at head size 512 on gfx803 (GCN4), Gemma 4's full-attention layers.
+//
+// The tile kernel at head size 512 holds too much per lane: its 32-column tile spills about
+// 6 KB per lane at the 128 VGPRs that 512 threads leave it, and still about 5.6 KB at 256
+// threads and 256 VGPRs. It runs at about 0.16 TFLOPS, while the image's gfx803 SGEMM runs
+// two fp32 GEMMs with an exact softmax between them at 2-3 TFLOPS.
+//
+// All scratch lies in dst's extra space (ggml_cuda_flash_attn_ext_get_alloc_size), so the
+// compute buffer reserves it.
+
+static constexpr int     fattn_gcn4_gemm_softmax_threads = 256;
+// Bytes of scores per chunk of query tokens, next to the fp32 K/V copies of up to 2 x 64 MiB
+// at 32k keys. 128 tokens at 8 query heads and 8192 keys still run the score GEMM at 2.3
+// TFLOPS and V*P at 3.0 on an RX 590.
+static constexpr int64_t fattn_gcn4_gemm_scores_budget   = 32ll*1024*1024;
+
+struct fattn_gcn4_gemm_layout {
+    int64_t chunk;   // query tokens per chunk
+    size_t  K_off;   // byte offsets into the extra space
+    size_t  V_off;
+    size_t  S_off;
+    size_t  size;    // bytes of extra space
+};
+
+static fattn_gcn4_gemm_layout fattn_gcn4_gemm_get_layout(const ggml_tensor * dst) {
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+
+    const int64_t D      = K->ne[0];
+    const int64_t n_kv   = K->ne[1];
+    const int64_t n_rows = Q->ne[2] / K->ne[2]; // query heads per K/V head
+
+    const int64_t S_col  = n_rows*n_kv*sizeof(float);
+
+    fattn_gcn4_gemm_layout l;
+    l.chunk = std::max<int64_t>(1, std::min<int64_t>(Q->ne[1], fattn_gcn4_gemm_scores_budget / S_col));
+    l.K_off = 0;
+    l.V_off = GGML_PAD(l.K_off + D*n_kv*sizeof(float), 128);
+    l.S_off = GGML_PAD(l.V_off + D*n_kv*sizeof(float), 128);
+    // The scores take the whole budget rather than chunk columns: a graph with fewer keys than the
+    // reserved one can fit one more column into the budget, and the reservation has to stay the larger.
+    l.size  = l.S_off + std::max<int64_t>(S_col, std::min<int64_t>(Q->ne[1]*S_col, fattn_gcn4_gemm_scores_budget));
+    return l;
+}
+
+// A column whose keys are all masked becomes zero, as the CPU backend's flash attention gives.
+static __global__ void fattn_gcn4_gemm_softmax(
+        float * __restrict__ S, const half * __restrict__ mask, const int n_kv, const int chunk,
+        const int64_t mask_s1) {
+    const int col = blockIdx.x;              // query token within the chunk
+    float     * x = S + ((int64_t) blockIdx.y*chunk + col)*n_kv;
+    const half * m = mask ? mask + col*mask_s1 : nullptr;
+
+    __shared__ float red[fattn_gcn4_gemm_softmax_threads/WARP_SIZE];
+
+    float vmax = -INFINITY;
+    for (int k = threadIdx.x; k < n_kv; k += blockDim.x) {
+        const float v = x[k] + (m ? __half2float(m[k]) : 0.0f);
+        x[k] = v;
+        vmax = fmaxf(vmax, v);
+    }
+    vmax = warp_reduce_max(vmax);
+    if (threadIdx.x % WARP_SIZE == 0) {
+        red[threadIdx.x / WARP_SIZE] = vmax;
+    }
+    __syncthreads();
+    vmax = red[0];
+    for (int w = 1; w < fattn_gcn4_gemm_softmax_threads/WARP_SIZE; ++w) {
+        vmax = fmaxf(vmax, red[w]);
+    }
+    __syncthreads();
+
+    if (vmax == -INFINITY) {
+        for (int k = threadIdx.x; k < n_kv; k += blockDim.x) {
+            x[k] = 0.0f;
+        }
+        return;
+    }
+
+    float sum = 0.0f;
+    for (int k = threadIdx.x; k < n_kv; k += blockDim.x) {
+        const float e = expf(x[k] - vmax);
+        x[k] = e;
+        sum += e;
+    }
+    sum = warp_reduce_sum(sum);
+    if (threadIdx.x % WARP_SIZE == 0) {
+        red[threadIdx.x / WARP_SIZE] = sum;
+    }
+    __syncthreads();
+    sum = 0.0f;
+    for (int w = 0; w < fattn_gcn4_gemm_softmax_threads/WARP_SIZE; ++w) {
+        sum += red[w];
+    }
+
+    const float inv = 1.0f/sum;
+    for (int k = threadIdx.x; k < n_kv; k += blockDim.x) {
+        x[k] *= inv;
+    }
+}
+
+static bool ggml_cuda_flash_attn_ext_gcn4_gemm_applies(const int device, const ggml_tensor * dst) {
+    const ggml_tensor * Q     = dst->src[0];
+    const ggml_tensor * K     = dst->src[1];
+    const ggml_tensor * V     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+
+    if (ggml_cuda_info().devices[device].cc != GGML_CUDA_CC_GCN4) {
+        return false;
+    }
+
+    float max_bias;
+    float logit_softcap;
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+
+    if (Q->ne[1] < 2 || K->ne[0] != 512 || V->ne[0] != 512 || max_bias != 0.0f || logit_softcap != 0.0f || sinks) {
+        return false;
+    }
+    if (Q->type != GGML_TYPE_F32 || Q->nb[0] != sizeof(float) || Q->nb[1] % sizeof(float) != 0 || Q->nb[2] % sizeof(float) != 0) {
+        return false;
+    }
+    if (Q->ne[2] % K->ne[2] != 0 || K->ne[2] != V->ne[2] || K->ne[3] != V->ne[3] || Q->ne[3] % K->ne[3] != 0) {
+        return false;
+    }
+    if (mask && (mask->type != GGML_TYPE_F16 || mask->ne[2] != 1)) {
+        return false;
+    }
+    if (K->nb[0] != ggml_type_size(K->type) || V->nb[0] != ggml_type_size(V->type)) {
+        return false;
+    }
+    if (!ggml_get_to_fp32_nc_cuda(K->type) || !ggml_get_to_fp32_nc_cuda(V->type)) {
+        return false;
+    }
+    return ggml_is_contiguous(dst);
+}
+
+static void ggml_cuda_flash_attn_ext_gcn4_gemm(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+
+    float scale;
+    memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+
+    const int64_t D       = K->ne[0];
+    const int64_t n_q     = Q->ne[1];
+    const int64_t n_head  = Q->ne[2];
+    const int64_t n_kv    = K->ne[1];
+    const int64_t n_rows  = n_head / K->ne[2];
+    const int64_t Q_s1    = Q->nb[1] / sizeof(float);
+    const int64_t Q_s2    = Q->nb[2] / sizeof(float);
+    const int64_t Q_s3    = Q->nb[3] / sizeof(float);
+
+    const fattn_gcn4_gemm_layout l = fattn_gcn4_gemm_get_layout(dst);
+    char  * extra = (char *) dst->data + GGML_PAD(ggml_nbytes(dst), 128);
+    float * K_f   = (float *) (extra + l.K_off);
+    float * V_f   = (float *) (extra + l.V_off);
+    float * S     = (float *) (extra + l.S_off);
+    float * O     = (float *) dst->data;
+
+    cudaStream_t   stream   = ctx.stream();
+    cublasHandle_t cublas_h = ctx.cublas_handle();
+
+    const to_fp32_nc_cuda_t K_to_f32 = ggml_get_to_fp32_nc_cuda(K->type);
+    const to_fp32_nc_cuda_t V_to_f32 = ggml_get_to_fp32_nc_cuda(V->type);
+    const size_t K_ts = ggml_type_size(K->type);
+    const size_t V_ts = ggml_type_size(V->type);
+
+    const float one  = 1.0f;
+    const float zero = 0.0f;
+
+    for (int64_t s = 0; s < Q->ne[3]; ++s) {
+        const int64_t s_kv = s / (Q->ne[3] / K->ne[3]);
+        for (int64_t h = 0; h < K->ne[2]; ++h) {
+            K_to_f32((const char *) K->data + s_kv*K->nb[3] + h*K->nb[2], K_f, D, n_kv, 1, 1,
+                K->nb[1]/K_ts, K->nb[2]/K_ts, K->nb[3]/K_ts, stream);
+            V_to_f32((const char *) V->data + s_kv*V->nb[3] + h*V->nb[2], V_f, D, n_kv, 1, 1,
+                V->nb[1]/V_ts, V->nb[2]/V_ts, V->nb[3]/V_ts, stream);
+
+            for (int64_t t0 = 0; t0 < n_q; t0 += l.chunk) {
+                const int64_t chunk = std::min(l.chunk, n_q - t0);
+                const float * Q_c = (const float *) Q->data + s*Q_s3 + h*n_rows*Q_s2 + t0*Q_s1;
+
+                // S[row][t] = scale * K_f^T Q[:, t, row]: n_kv x chunk per query head, columns n_kv apart.
+                CUBLAS_CHECK(cublasSgemmStridedBatched(cublas_h, CUBLAS_OP_T, CUBLAS_OP_N,
+                    n_kv, chunk, D,
+                    &scale, K_f, D, 0,
+                            Q_c, Q_s1, Q_s2,
+                    &zero,  S, n_kv, chunk*n_kv,
+                    n_rows));
+
+                const half * mask_c = mask ? (const half *) ((const char *) mask->data + (s % mask->ne[3])*mask->nb[3] + t0*mask->nb[1]) : nullptr;
+                fattn_gcn4_gemm_softmax<<<dim3(chunk, n_rows), fattn_gcn4_gemm_softmax_threads, 0, stream>>>(
+                    S, mask_c, n_kv, chunk, mask ? mask->nb[1]/sizeof(half) : 0);
+                CUDA_CHECK(cudaGetLastError());
+
+                // dst row (t, head) = V_f P[:, t]: the rows of one token hold all n_head query heads.
+                CUBLAS_CHECK(cublasSgemmStridedBatched(cublas_h, CUBLAS_OP_N, CUBLAS_OP_N,
+                    D, chunk, n_kv,
+                    &one,  V_f, D, 0,
+                           S, n_kv, chunk*n_kv,
+                    &zero, O + ((s*n_q + t0)*n_head + h*n_rows)*D, n_head*D, D,
+                    n_rows));
+            }
+        }
+    }
+}
