+    if (!(mode & GGML_ROPE_TYPE_MROPE) || mode == GGML_ROPE_TYPE_VISION || (mode & GGML_ROPE_TYPE_NEOX)) {
+        return false;
+    }
+    int sections[4];
+    memcpy(sections, params + 11, sizeof(sections));
+    if (sections[0] <= 0 && sections[1] <= 0 && sections[2] <= 0) {
+        return false;
+    }
+    const int64_t N = x->ne[0];
+    if (x->type != GGML_TYPE_F32 || x->nb[0] != sizeof(float) || x->ne[2] != 1 || x->ne[3] != 1 || pos->type != GGML_TYPE_I32 ||
+            !ggml_cuda_fwht_size_supported(N) || n_dims <= 0 || n_dims % 2 != 0 || n_offs < 0 || n_offs % 2 != 0 ||
+            n_offs + n_dims > N || !ggml_cuda_single_use(cgraph, rope)) {
+        return false;
+    }
