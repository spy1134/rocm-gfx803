+// A RESHAPE/VIEW of all of src's bytes in order: offset 0 from the same root, contiguous, as many elements.
+static bool ggml_cuda_is_same_bytes_view(const ggml_tensor * view, const ggml_tensor * src) {
+    const ggml_tensor * root = src->view_src ? src->view_src : src;
+    return (view->op == GGML_OP_RESHAPE || view->op == GGML_OP_VIEW) && view->src[0] == src &&
+        view->view_src == root && view->view_offs == src->view_offs && ggml_is_contiguous(view) &&
+        ggml_is_contiguous(src) && ggml_nelements(view) == ggml_nelements(src) && view->type == src->type;
+}
+
+// Walks from t back through same-bytes views, each read only by the next, to the tensor that produced the
+// bytes; nullptr when a view in between has other readers.
+static const ggml_tensor * ggml_cuda_same_bytes_origin(const ggml_cgraph * cgraph, const ggml_tensor * t) {
+    while (t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW) {
+        const ggml_tensor * src = t->src[0];
+        if (src == nullptr || !ggml_cuda_is_same_bytes_view(t, src) || !ggml_cuda_single_use(cgraph, src)) {
+            return nullptr;
+        }
+        t = src;
+    }
+    return t;
+}
+
+// An exact alias (same bytes, same order) is safe for kernels that read every value in the thread or warp that
+// writes it; any other overlap is not.
+static bool ggml_cuda_overlap_unless_alias(const ggml_tensor * dst, const ggml_tensor * src) {
+    if (!ggml_cuda_bytes_overlap(dst, src)) {
+        return false;
+    }
+    return !(dst->data == src->data && ggml_is_contiguous(dst) && ggml_is_contiguous(src) &&
+             ggml_nbytes(dst) == ggml_nbytes(src));
