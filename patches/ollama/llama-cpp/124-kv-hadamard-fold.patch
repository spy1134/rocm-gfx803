+// ROPE (rope_multi: MROPE or IMROPE, f32) -> same-bytes views -> the Hadamard MUL_MAT that the q8_0 KV cache
+// adds after the rotation (fwht over rows of the rope's head size), optionally followed through same-bytes
+// views by the q8_0 SET_ROWS that stores the result (K). Only views lie between the nodes, and every
+// intermediate is read only along the chain. One kernel runs rope, transform and, for K, the store.
+struct ggml_cuda_rope_fwht_match {
+    ggml_tensor * rope     = nullptr;
+    ggml_tensor * fwht     = nullptr;
+    ggml_tensor * set_rows = nullptr;
+    int           last     = -1;
+};
+
+static bool ggml_cuda_match_rope_fwht(const ggml_cgraph * cgraph, int i, ggml_cuda_rope_fwht_match & m) {
+    ggml_tensor * rope = cgraph->nodes[i];
+    if (rope->op != GGML_OP_ROPE || rope->type != GGML_TYPE_F32 || !ggml_is_contiguous(rope)) {
+        return false;
+    }
+    const ggml_tensor * x   = rope->src[0];
+    const ggml_tensor * pos = rope->src[1];
+    const int32_t * params = (const int32_t *) rope->op_params;
+    const int n_dims = params[1];
+    const int mode   = params[2];
+    const int n_offs = params[15];
