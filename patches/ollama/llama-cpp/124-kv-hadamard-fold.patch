+    }
+    const int last = std::min(cgraph->n_nodes - 2, i + ggml_cuda_deferred_window);
+    for (int j = i + 1; j <= last; ++j) {
+        ggml_cuda_attn_gate_match m;
+        if (ggml_cuda_is_unary_op(cgraph->nodes[j], GGML_UNARY_OP_SIGMOID) &&
+                ggml_cuda_match_attn_gate(cgraph, j, m, /*check_data=*/true) && m.fwht_idx == i) {
+            return true;
+        }
+    }
+    return false;
+}
