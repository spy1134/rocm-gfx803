+// rope_multi (forward, f32) followed by fwht_cuda over each rotated row, one row per warp as fwht_cuda runs
+// it; with to_q8_0 also the q8_0 set_rows of the result (row id per token, a token's heads side by side).
+// Each element is rope_multi's expression for its channel: a copy outside the rotated window, otherwise
+// x0*cos - x1*sin or x0*sin + x1*cos of its pair, with theta from the same code; the lane holding the
+// second channel of a pair recomputes the pair's angle from the same inputs.
+template <int N, bool has_ff, bool to_q8_0>
+__launch_bounds__(4*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void rope_multi_fwht(const float *        x,
+                                       float *              dst,
+                                       char *               dst_q8_0,
+                                       const int64_t *      ids,
+                                       const int64_t        s_ids,
+                                       const int64_t        s_dst,
+                                       const int            ne01,
+                                       const int            ne02,
+                                       const int            s01,
+                                       const int            s02,
+                                       const int            s03,
+                                       const int            nr,
+                                       const int            n_dims,
+                                       const int            n_offs,
+                                       const int32_t *      pos,
+                                       const float          freq_scale,
+                                       const float          ext_factor,
+                                       const float          attn_factor,
+                                       const rope_corr_dims corr_dims,
+                                       const float          theta_scale,
+                                       const float *        freq_factors,
+                                       const mrope_sections sections,
+                                       const bool           is_imrope,
+                                       const float          fwht_scale) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    static constexpr int el_w = N / warp_size;
+
+    const int row = blockIdx.x * blockDim.y + threadIdx.y;
+    if (row >= nr) {
+        return;
+    }
+    const int lane = threadIdx.x;
+
+    const uint32_t i3 = row / (ne01 * ne02);
+    const uint32_t i2 = (row - i3 * ne01 * ne02) / ne01;
+    const uint32_t i1 = row - i3 * ne01 * ne02 - i2 * ne01;
+
+    const int ix = i1 * s01 + i2 * s02 + i3 * s03;
+
+    const int sect_dims = sections.v[0] + sections.v[1] + sections.v[2] + sections.v[3];
+    const int sec_w = sections.v[1] + sections.v[0];
+
+    float reg[el_w];
+
+    ggml_cuda_pdl_sync();
+#pragma unroll
+    for (int i = 0; i < el_w; ++i) {
+        const int c = i * warp_size + lane;
+        float v;
+        if (c < n_offs || c >= n_offs + n_dims) {
+            v = x[ix + c];
+        } else {
+            const bool first = c - n_offs < n_dims/2;
+            const int  p     = first ? c - n_offs : c - n_offs - n_dims/2;
+            const int  iw    = 2 * p;
+
+            const int sector = (iw / 2) % sect_dims;
+
+            float theta_base = 0.0;
+            if (is_imrope) {
+                if (sector % 3 == 1 && sector < 3 * sections.v[1]) {         // h
+                    theta_base = pos[i2 + ne02 * 1] * powf(theta_scale, iw / 2.0f);
+                } else if (sector % 3 == 2 && sector < 3 * sections.v[2]) {  // w
+                    theta_base = pos[i2 + ne02 * 2] * powf(theta_scale, iw / 2.0f);
+                } else if (sector % 3 == 0 && sector < 3 * sections.v[0]) {  // t
+                    theta_base = pos[i2] * powf(theta_scale, iw / 2.0f);
+                } else {
+                    theta_base = pos[i2 + ne02 * 3] * powf(theta_scale, iw / 2.0f);
+                }
+            } else {
+                if (sector < sections.v[0]) {
+                    theta_base = pos[i2] * powf(theta_scale, iw / 2.0f);
+                } else if (sector >= sections.v[0] && sector < sec_w) {
+                    theta_base = pos[i2 + ne02 * 1] * powf(theta_scale, iw / 2.0f);
+                } else if (sector >= sec_w && sector < sec_w + sections.v[2]) {
+                    theta_base = pos[i2 + ne02 * 2] * powf(theta_scale, iw / 2.0f);
+                } else if (sector >= sec_w + sections.v[2]) {
+                    theta_base = pos[i2 + ne02 * 3] * powf(theta_scale, iw / 2.0f);
+                }
+            }
+
+            const float freq_factor = has_ff ? freq_factors[iw/2] : 1.0f;
+
+            float cos_theta;
+            float sin_theta;
+
+            rope_yarn<true>(theta_base/freq_factor, freq_scale, corr_dims, iw, ext_factor, attn_factor, cos_theta, sin_theta);
+
+            const float x0 = x[ix + n_offs + p];
+            const float x1 = x[ix + n_offs + p + n_dims/2];
+
+            v = first ? x0*cos_theta - x1*sin_theta : x0*sin_theta + x1*cos_theta;
+        }
+        reg[i] = v * fwht_scale;
+    }
+
+    ggml_cuda_fwht_row<N>(reg, lane);
+
+    if constexpr (to_q8_0) {
+        block_q8_0 * dst_row = (block_q8_0 *) (dst_q8_0 + ids[i2 * s_ids] * s_dst);
+#pragma unroll
+        for (int i = 0; i < el_w; ++i) {
+            const int c = i1 * N + i * warp_size + lane;
+            ggml_cuda_quantize_q8_0_lanes(reg[i], dst_row + c / QK8_0, c % QK8_0);
+        }
+    } else {
+#pragma unroll
+        for (int i = 0; i < el_w; ++i) {
+            dst[(int64_t) row * N + i * warp_size + lane] = reg[i];
+        }
+    }
+}
+
+template <int N, bool to_q8_0>
+static void rope_multi_fwht_cuda(const float * x, float * dst, char * dst_q8_0, const int64_t * ids, const int64_t s_ids,
+                                 const int64_t s_dst, const int ne01, const int ne02, const int s01, const int s02,
+                                 const int s03, const int nr, const int n_dims, const int n_offs, const int32_t * pos,
+                                 const float freq_scale, const float freq_base, const float ext_factor,
+                                 const float attn_factor, const rope_corr_dims corr_dims, const float * freq_factors,
+                                 const mrope_sections sections, const bool is_imrope, const int warp_size,
+                                 cudaStream_t stream) {
+    const dim3 block_dims(warp_size, ggml_cuda_fwht_rows_per_block, 1);
+    const dim3 block_nums((nr + ggml_cuda_fwht_rows_per_block - 1) / ggml_cuda_fwht_rows_per_block, 1, 1);
+
+    const float theta_scale = powf(freq_base, -2.0f / n_dims);
+    const float fwht_scale  = 1 / sqrtf(N);
+
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
+    if (freq_factors == nullptr) {
+        ggml_cuda_kernel_launch(rope_multi_fwht<N, false, to_q8_0>, launch_params, x, dst, dst_q8_0, ids, s_ids, s_dst,
+            ne01, ne02, s01, s02, s03, nr, n_dims, n_offs, pos, freq_scale, ext_factor, attn_factor, corr_dims,
+            theta_scale, freq_factors, sections, is_imrope, fwht_scale);
+    } else {
+        ggml_cuda_kernel_launch(rope_multi_fwht<N, true, to_q8_0>, launch_params, x, dst, dst_q8_0, ids, s_ids, s_dst,
+            ne01, ne02, s01, s02, s03, nr, n_dims, n_offs, pos, freq_scale, ext_factor, attn_factor, corr_dims,
+            theta_scale, freq_factors, sections, is_imrope, fwht_scale);
+    }
+}
