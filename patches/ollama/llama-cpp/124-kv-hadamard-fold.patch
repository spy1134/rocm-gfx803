+    const ggml_tensor * cur = rope;
+    int j = i + 1;
+    for (; j < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[j]); ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->src[0] == cur) {
+            if (!ggml_cuda_is_same_bytes_view(n, cur) || !ggml_cuda_single_use(cgraph, n)) {
+                return false;
+            }
+            cur = n;
+        }
+    }
+    if (j == cgraph->n_nodes) {
+        return false;
+    }
+    ggml_tensor * fwht = cgraph->nodes[j];
+    if (fwht->op != GGML_OP_MUL_MAT || !ggml_cuda_op_mul_mat_use_fwht(fwht) || fwht->src[1] != cur ||
+            cur->type != GGML_TYPE_F32 || cur->ne[0] != N) {
+        return false;
+    }
+    m.rope     = rope;
+    m.fwht     = fwht;
+    m.set_rows = nullptr;
+    m.last     = j;
+
+    // K: the transformed rows go straight into the q8_0 cache, one row id per token
+    if (ggml_cuda_single_use(cgraph, fwht)) {
