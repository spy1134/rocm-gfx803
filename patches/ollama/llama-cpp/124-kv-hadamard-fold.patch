+// fwht_cuda with the q8_0 set_rows that reads its result in the same kernel: row r of the transform is
+// N consecutive values of the set_rows source, whose rows (one per row id) hold rows_per_id transform rows.
+template <int N>
+__launch_bounds__(4*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void fwht_set_rows_q8_0_cuda(const float * src, const int64_t * ids, char * dst, const int64_t n_rows,
+                                               const int rows_per_id, const int64_t s_ids, const int64_t s_dst,
+                                               const float scale) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+
+    const int64_t r = (int64_t) blockIdx.x * blockDim.y + threadIdx.y;
+
+    if (r >= n_rows) {
+        return;
+    }
+
+    src += r * N;
+
+    static constexpr int el_w = N / warp_size;
+    float     reg[el_w];
+    const int lane = threadIdx.x;
+
+    ggml_cuda_pdl_sync();
+#pragma unroll
+    for (int i = 0; i < el_w; ++i) {
+        reg[i] = src[i * warp_size + lane] * scale;
+    }
+
+    ggml_cuda_fwht_row<N>(reg, lane);
+
+    const int64_t row_id = ids[(r / rows_per_id) * s_ids];
+    block_q8_0 *  dst_row = (block_q8_0 *) (dst + row_id * s_dst);
+    const int     c0      = (int) (r % rows_per_id) * N;
+
+#pragma unroll
+    for (int i = 0; i < el_w; ++i) {
+        const int c = c0 + i * warp_size + lane;
+        ggml_cuda_quantize_q8_0_lanes(reg[i], dst_row + c / QK8_0, c % QK8_0);
+    }
+}
+
+void ggml_cuda_op_fwht_set_rows_q8_0(ggml_backend_cuda_context & ctx, const ggml_tensor * x, const ggml_tensor * set_rows) {
+    const ggml_tensor * src     = set_rows->src[0];
+    const ggml_tensor * ids     = set_rows->src[1];
+    const int           n       = x->ne[0];
+    const int64_t       rows    = ggml_nrows(x);
+    const int           per_id  = src->ne[0] / n;
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && ggml_is_contiguous(x) && set_rows->type == GGML_TYPE_Q8_0);
+    GGML_ASSERT(ids->type == GGML_TYPE_I64 && src->ne[0] % n == 0 && rows == per_id * src->ne[1]);
+
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+
+    const dim3 grid_dims((rows + ggml_cuda_fwht_rows_per_block - 1) / ggml_cuda_fwht_rows_per_block, 1, 1);
+    const dim3 block_dims(warp_size, ggml_cuda_fwht_rows_per_block, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid_dims, block_dims, 0, ctx.stream());
+
+    const float * x_d     = (const float *) x->data;
+    const int64_t * ids_d = (const int64_t *) ids->data;
+    char *        dst_d   = (char *) set_rows->data;
+    const int64_t s_ids   = ids->nb[0] / sizeof(int64_t);
+    const int64_t s_dst   = set_rows->nb[1];
+    const float   scale   = 1 / sqrtf(n);
+
+    switch (n) {
+        case 64:
+            ggml_cuda_kernel_launch(fwht_set_rows_q8_0_cuda<64>, launch_params, x_d, ids_d, dst_d, rows, per_id, s_ids, s_dst, scale);
