+
+// fwht_cuda over the rows of src (one row per warp, as fwht_cuda runs it), then op_sigmoid(x) * the
+// transformed value as unary_gated_op_kernel computes it, x read from rows of n values o0 apart.
+template <int N>
+__launch_bounds__(4*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void fwht_sigmoid_mul_f32(const float * src, const float * x, float * dst, const int64_t n_rows,
+                                            const int64_t n, const int64_t o0, const float scale) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    static constexpr int el_w = N / warp_size;
+
+    const int64_t r = (int64_t) blockIdx.x * blockDim.y + threadIdx.y;
+    if (r >= n_rows) {
+        return;
+    }
+    const int lane = threadIdx.x;
+
+    float reg[el_w];
+
+    ggml_cuda_pdl_sync();
+#pragma unroll
+    for (int i = 0; i < el_w; ++i) {
+        reg[i] = src[r * N + i * warp_size + lane] * scale;
+    }
+
+    ggml_cuda_fwht_row<N>(reg, lane);
+
+#pragma unroll
+    for (int i = 0; i < el_w; ++i) {
+        const int64_t k  = r * N + i * warp_size + lane;
+        const int64_t j0 = (k / n) * o0 + (k % n);
+        dst[k] = op_sigmoid(x[j0]) * reg[i];
+    }
+}
+
+void ggml_cuda_op_fwht_sigmoid_mul(ggml_backend_cuda_context & ctx, const ggml_tensor * fwht_src, const float * x,
+                                   const int64_t n, const int64_t o0, float * dst) {
+    const int     N    = fwht_src->ne[0];
+    const int64_t rows = ggml_nrows(fwht_src);
+
+    GGML_ASSERT(fwht_src->type == GGML_TYPE_F32 && ggml_is_contiguous(fwht_src));
+
+    const int warp_size = ggml_cuda_info().devices[ctx.device].warp_size;
+
+    const dim3 grid_dims((rows + ggml_cuda_fwht_rows_per_block - 1) / ggml_cuda_fwht_rows_per_block, 1, 1);
+    const dim3 block_dims(warp_size, ggml_cuda_fwht_rows_per_block, 1);
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid_dims, block_dims, 0, ctx.stream());
+
+    const float * src   = (const float *) fwht_src->data;
+    const float   scale = 1 / sqrtf(N);
+
+    switch (N) {
+        case 64:
+            ggml_cuda_kernel_launch(fwht_sigmoid_mul_f32<64>, launch_params, src, x, dst, rows, n, o0, scale);
+            break;
+        case 128:
+            ggml_cuda_kernel_launch(fwht_sigmoid_mul_f32<128>, launch_params, src, x, dst, rows, n, o0, scale);
+            break;
+        case 256:
+            ggml_cuda_kernel_launch(fwht_sigmoid_mul_f32<256>, launch_params, src, x, dst, rows, n, o0, scale);
+            break;
+        case 512:
+            ggml_cuda_kernel_launch(fwht_sigmoid_mul_f32<512>, launch_params, src, x, dst, rows, n, o0, scale);
+            break;
+        default:
+            GGML_ABORT("unsupported transform size %d", N);
+    }
+}
