 // Returns whether the Fast Walsh-Hadamard transform could be used.
 bool ggml_cuda_op_fwht(ggml_backend_cuda_context & ctx, const ggml_tensor * src, ggml_tensor * dst);
+
+// fwht_cuda's butterfly network for kernels that hold a row in registers themselves: lane l holds elements
+// i * warp_size + l. Same additions, subtractions and order as fwht_cuda, so the rotated values are the
+// same bits.
+template <int N>
+static __device__ __forceinline__ void ggml_cuda_fwht_row(float * reg, const int lane) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int el_w      = N / warp_size;
+
+#pragma unroll
+    for (int h = 1; h < warp_size; h *= 2) {
+#pragma unroll
+        for (int j = 0; j < el_w; j++) {
+            const float val  = reg[j];
+            const float val2 = __shfl_xor_sync(0xFFFFFFFF, val, h, warp_size);
+
+            reg[j] = (lane & h) == 0 ? val + val2 : val2 - val;
+        }
+    }
+
+#pragma unroll
+    for (int h = warp_size; h < N; h *= 2) {
+        const int step = h / warp_size;
+#pragma unroll
+        for (int j = 0; j < el_w; j += 2 * step) {
+#pragma unroll
+            for (int k = 0; k < step; k++) {
+                const float x = reg[j + k];
+                const float y = reg[j + k + step];
+
+                reg[j + k]        = x + y;
+                reg[j + k + step] = x - y;
+            }
+        }
+    }
+}
+
+// quantize_f32_q8_0_block for a block whose value j is held by lane j of a 32-lane group. amax is a maximum,
+// which is exact in any order; starting each lane at fmaxf(0, |v|) gives the serial loop's result for NaN
+// inputs too. d, id and roundf(v * id) are the same expressions.
+static __device__ __forceinline__ void ggml_cuda_quantize_q8_0_lanes(const float v, block_q8_0 * y, const int j) {
+    const float amax = warp_reduce_max<32>(fmaxf(0.0f, fabsf(v)));
+
+    const float d  = amax / ((1 << 7) - 1);
+    const float id = d ? 1.0f/d : 0.0f;
+
+    if (j == 0) {
+        y->d = d;
+    }
+    y->qs[j] = roundf(v*id);
+}
+
+// One fwht row per warp, as fwht_cuda launches it.
+static constexpr int ggml_cuda_fwht_rows_per_block = 4;
+
+bool ggml_cuda_fwht_size_supported(int64_t n);
+
+// (see ggml_cuda_match_fwht_set_rows) The transform of x followed by the set_rows of its result into a q8_0
+// cache: x holds the rows of the transform, set_rows the destination and row ids.
+void ggml_cuda_op_fwht_set_rows_q8_0(ggml_backend_cuda_context & ctx, const ggml_tensor * x, const ggml_tensor * set_rows);
