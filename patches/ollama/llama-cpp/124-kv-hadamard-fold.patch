+        int k = j + 1;
+        for (; k < cgraph->n_nodes && ggml_cuda_is_view_or_noop(cgraph->nodes[k]); ++k) {
+            const ggml_tensor * n = cgraph->nodes[k];
+            if (n->src[0] == cur) {
+                if (!ggml_cuda_is_same_bytes_view(n, cur) || !ggml_cuda_single_use(cgraph, n)) {
+                    break;
+                }
+                cur = n;
+            }
+        }
+        if (k < cgraph->n_nodes) {
+            ggml_tensor *       sr  = cgraph->nodes[k];
+            const ggml_tensor * ids = sr->src[1];
+            if (sr->op == GGML_OP_SET_ROWS && sr->src[0] == cur && sr->type == GGML_TYPE_Q8_0 &&
+                    ids->type == GGML_TYPE_I64 && cur->ne[0] == N * x->ne[1] && cur->ne[1] == x->ne[2] &&
+                    cur->ne[2] == 1 && cur->ne[3] == 1 && ids->ne[0] == cur->ne[1] && ids->ne[1] == 1 && ids->ne[2] == 1 &&
+                    sr->ne[0] == cur->ne[0] && sr->ne[2] == 1 && sr->ne[3] == 1) {
+                m.set_rows = sr;
+                m.last     = k;
+            }
+        }
+    }
