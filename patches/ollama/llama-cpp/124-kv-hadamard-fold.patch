+        case 128:
+            ggml_cuda_kernel_launch(fwht_set_rows_q8_0_cuda<128>, launch_params, x_d, ids_d, dst_d, rows, per_id, s_ids, s_dst, scale);
+            break;
+        case 256:
+            ggml_cuda_kernel_launch(fwht_set_rows_q8_0_cuda<256>, launch_params, x_d, ids_d, dst_d, rows, per_id, s_ids, s_dst, scale);
+            break;
+        case 512:
+            ggml_cuda_kernel_launch(fwht_set_rows_q8_0_cuda<512>, launch_params, x_d, ids_d, dst_d, rows, per_id, s_ids, s_dst, scale);
+            break;
+        default:
