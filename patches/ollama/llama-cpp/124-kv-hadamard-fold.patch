+}
+
+static bool ggml_cuda_try_rope_fwht(ggml_backend_cuda_context * ctx, ggml_cgraph * cgraph, int i, int * skip) {
+    if (cgraph->nodes[i]->op != GGML_OP_ROPE) {
+        return false;
+    }
+    ggml_cuda_rope_fwht_match m;
+    if (!ggml_cuda_match_rope_fwht(cgraph, i, m)) {
+        return false;
+    }
+    const ggml_tensor * x = m.rope->src[0];
+    for (const ggml_tensor * t : { m.rope->src[1], m.rope->src[2] }) {
+        if (t != nullptr && (ggml_cuda_bytes_overlap(m.fwht, t) || (m.set_rows && ggml_cuda_bytes_overlap(m.set_rows, t)))) {
+            return false;
+        }
+    }
+    // a warp reads its whole row before it writes that row
+    if (m.set_rows != nullptr ? ggml_cuda_bytes_overlap(m.set_rows, x) : ggml_cuda_overlap_unless_alias(m.fwht, x)) {
+        return false;
+    }
+    ggml_cuda_op_rope_multi_fwht(*ctx, m.rope, m.fwht, m.set_rows);
+    *skip = m.last - i;
+    return true;
+}
+
+// A q8_0 SET_ROWS whose source is, through same-bytes views read only along the chain, the Hadamard MUL_MAT
+// of the KV cache rotation (V; K when its rope did not take it). The transform is not run at its own node:
+// at the SET_ROWS one kernel transforms and stores. With check_data the tensors' memory is known and checked
+// too; graph_optimize calls it without, to keep the transform's input allocated until the SET_ROWS.
+struct ggml_cuda_fwht_set_rows_match {
+    int                 fwht_idx = -1;
+    const ggml_tensor * x        = nullptr;
+};
+
+static bool ggml_cuda_match_fwht_set_rows(const ggml_cgraph * cgraph, int sr_idx, ggml_cuda_fwht_set_rows_match & m,
+        bool check_data) {
+    const ggml_tensor * sr = cgraph->nodes[sr_idx];
+    if (sr->op != GGML_OP_SET_ROWS || sr->type != GGML_TYPE_Q8_0) {
+        return false;
+    }
+    const ggml_tensor * src = sr->src[0];
+    const ggml_tensor * ids = sr->src[1];
+    if (src->type != GGML_TYPE_F32 || !ggml_is_contiguous(src) || src->ne[1] != 1 || src->ne[2] != 1 || src->ne[3] != 1 ||
+            ids->type != GGML_TYPE_I64 || ids->ne[0] != src->ne[1] || ids->ne[1] != 1 || ids->ne[2] != 1 ||
+            sr->ne[0] != src->ne[0] || sr->ne[2] != 1 || sr->ne[3] != 1 || !ggml_cuda_single_use(cgraph, src)) {
+        return false;
+    }
+    const ggml_tensor * fwht = ggml_cuda_same_bytes_origin(cgraph, src);
+    if (fwht == nullptr || fwht == src || fwht->op != GGML_OP_MUL_MAT || !ggml_cuda_op_mul_mat_use_fwht(fwht)) {
+        return false;
+    }
+    const ggml_tensor * x = fwht->src[1];
+    if (x->type != GGML_TYPE_F32 || !ggml_cuda_fwht_size_supported(x->ne[0]) || src->ne[0] % x->ne[0] != 0) {
