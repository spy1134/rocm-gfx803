+        }
+    }
+    return false;
+}
+
+// The sigmoid gate of a gated attention output (Qwen3.5/3.6), SIGMOID(gate) -> MUL(attn, sigmoid) as the
+// fused unary * mul takes it, where attn is a same-bytes view of the Hadamard MUL_MAT that undoes the V
+// rotation of the q8_0 cache on the attention output. The transform is not run when the loop reaches it; at
+// the SIGMOID one kernel transforms and gates. With check_data the tensors' memory is known and checked too;
+// graph_optimize calls it without, to keep the transform's input allocated until the MUL.
+struct ggml_cuda_attn_gate_match {
+    int                 fwht_idx = -1;
+    const ggml_tensor * fwht_src = nullptr;
+    const ggml_tensor * x        = nullptr;
+    int64_t             n        = 0;
+    int64_t             o0       = 0;
+    ggml_tensor *       dst      = nullptr;
+};
+
+static bool ggml_cuda_match_attn_gate(const ggml_cgraph * cgraph, int i, ggml_cuda_attn_gate_match & m, bool check_data) {
+    if (i + 1 >= cgraph->n_nodes || !ggml_cuda_is_unary_op(cgraph->nodes[i], GGML_UNARY_OP_SIGMOID) ||
+            !ggml_cuda_can_fuse(cgraph, i, { GGML_OP_UNARY, GGML_OP_MUL }, { GGML_UNARY_OP_SIGMOID })) {
+        return false;
+    }
+    const ggml_tensor * sig = cgraph->nodes[i];
+    ggml_tensor *       mul = cgraph->nodes[i + 1];
+    const ggml_tensor * g   = ggml_cuda_other_src(mul, sig);
+    if (sig->type != GGML_TYPE_F32 || !ggml_cuda_f32_contiguous(mul) || ggml_nrows(mul) != 1 || g == nullptr || g == sig ||
+            !ggml_cuda_f32_contiguous(g) || ggml_nelements(g) != ggml_nelements(mul)) {
+        return false;
+    }
+    const ggml_tensor * x = sig->src[0];
+
+    const ggml_tensor * fwht = ggml_cuda_same_bytes_origin(cgraph, g);
+    if (fwht == nullptr || fwht == g || fwht->op != GGML_OP_MUL_MAT || !ggml_cuda_op_mul_mat_use_fwht(fwht) ||
+            !ggml_cuda_single_use(cgraph, fwht) || fwht->src[1]->type != GGML_TYPE_F32 ||
+            !ggml_cuda_fwht_size_supported(fwht->src[1]->ne[0])) {
+        return false;
+    }
+    const int fwht_idx = ggml_cuda_node_index_before(cgraph, i, fwht, ggml_cuda_deferred_window);
+    if (fwht_idx < 0) {
+        return false;
+    }
+    const ggml_tensor * fwht_src = fwht->src[1];
+
+    if (check_data) {
+        // the transform's input is read at the SIGMOID: nothing in between may write it
+        if (!ggml_cuda_bytes_untouched(cgraph, fwht_idx, i, fwht_src->data, ggml_nbytes(fwht_src), false, {})) {
+            return false;
+        }
+        if (ggml_cuda_overlap_unless_alias(mul, x) || ggml_cuda_overlap_unless_alias(mul, fwht_src)) {
+            return false;
+        }
+    }
+    m.fwht_idx = fwht_idx;
+    m.fwht_src = fwht_src;
+    m.x        = x;
+    m.n        = x->ne[0];
+    m.o0       = x->nb[1] / sizeof(float);
+    m.dst      = mul;
+    return true;
+}
+
+static bool ggml_cuda_try_attn_gate(ggml_backend_cuda_context * ctx, ggml_cgraph * cgraph, int i, int * skip) {
+    const ggml_tensor * node = cgraph->nodes[i];
+    if (ggml_cuda_is_unary_op(node, GGML_UNARY_OP_SIGMOID)) {
