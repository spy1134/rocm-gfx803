+template <int qk, int qr, dequantize_kernel_t dequantize_kernel>
+static __global__ void dequantize_block_ld(const void * __restrict__ vx, float * __restrict__ y,
+        const int64_t ne00, const int64_t ne01, const int64_t ld) {
+    const int64_t i00 = 2 * (int64_t(blockDim.x)*blockIdx.x + threadIdx.x);
+
+    if (i00 >= ne00) {
+        return;
+    }
+
+    const int64_t iqs      = (i00%qk)/qr;
+    const int64_t iybs     = i00 - i00%qk;
+    const int64_t y_offset = qr == 1 ? 1 : qk/2;
+
+    for (int64_t i01 = blockIdx.y; i01 < ne01; i01 += gridDim.y) {
+        float2 v;
+        dequantize_kernel(vx, i01*(ne00/qk) + i00/qk, iqs, v);
+
+        y[i01*ld + iybs + iqs + 0]        = v.x;
+        y[i01*ld + iybs + iqs + y_offset] = v.y;
+    }
+}
+
+template <int qk, int qr, dequantize_kernel_t dequantize_kernel>
+static void dequantize_block_ld_cuda(const void * vx, float * y, const int64_t ne00, const int64_t ne01, const int64_t ld,
+        cudaStream_t stream) {
+    const dim3 num_blocks((ne00 + 2*CUDA_DEQUANTIZE_BLOCK_SIZE - 1) / (2*CUDA_DEQUANTIZE_BLOCK_SIZE), (int)std::min(ne01, (int64_t)65535));
+    dequantize_block_ld<qk, qr, dequantize_kernel><<<num_blocks, CUDA_DEQUANTIZE_BLOCK_SIZE, 0, stream>>>(vx, y, ne00, ne01, ld);
+}
+
+// One QK_K super-block per workgroup, as in the dequantize_row_*_cuda launchers.
+template <int nth, void (*dequantize)(const void *, const int64_t, float *, const int)>
+static __global__ void dequantize_block_k_ld(const void * __restrict__ vx, float * __restrict__ y, const int64_t nb_row, const int64_t ld) {
+    const int64_t i = blockIdx.x;
+    const int64_t r = i / nb_row;
+
+    dequantize(vx, i, y + r*ld + (i - r*nb_row)*QK_K, threadIdx.x);
+}
+
+template <int nth, void (*dequantize)(const void *, const int64_t, float *, const int)>
+static void dequantize_k_ld_cuda(const void * vx, float * y, const int64_t ne00, const int64_t ne01, const int64_t ld,
+        cudaStream_t stream) {
+    const int64_t nb_row = ne00 / QK_K;
+    dequantize_block_k_ld<nth, dequantize><<<nb_row*ne01, nth, 0, stream>>>(vx, y, nb_row, ld);
+}
+
+to_fp32_ld_cuda_t ggml_get_to_fp32_ld_cuda(ggml_type type, int64_t ne00) {
+    switch (type) {
+        case GGML_TYPE_Q4_0:
+            return dequantize_block_ld_cuda<QK4_0, QR4_0, dequantize_q4_0>;
+        case GGML_TYPE_Q4_1:
+            return dequantize_block_ld_cuda<QK4_1, QR4_1, dequantize_q4_1>;
+        case GGML_TYPE_Q5_0:
+            return dequantize_block_ld_cuda<QK5_0, QR5_0, dequantize_q5_0>;
+        case GGML_TYPE_Q5_1:
+            return dequantize_block_ld_cuda<QK5_1, QR5_1, dequantize_q5_1>;
+        case GGML_TYPE_Q8_0:
+            return dequantize_block_ld_cuda<QK8_0, QR8_0, dequantize_q8_0>;
+        default:
+            break;
+    }
+    if (ne00 % QK_K != 0) {
+        return nullptr;
+    }
+    switch (type) {
+        case GGML_TYPE_Q2_K:    return dequantize_k_ld_cuda<64, dequantize_q2_K<float>>;
+        case GGML_TYPE_Q3_K:    return dequantize_k_ld_cuda<64, dequantize_q3_K<float>>;
+        case GGML_TYPE_Q4_K:    return dequantize_k_ld_cuda<32, dequantize_q4_K<float>>;
+        case GGML_TYPE_Q5_K:    return dequantize_k_ld_cuda<64, dequantize_q5_K<float>>;
+        case GGML_TYPE_Q6_K:    return dequantize_k_ld_cuda<64, dequantize_q6_K<float>>;
+        case GGML_TYPE_IQ2_XXS: return dequantize_k_ld_cuda<32, dequantize_iq2_xxs<float>>;
+        case GGML_TYPE_IQ2_XS:  return dequantize_k_ld_cuda<32, dequantize_iq2_xs<float>>;
+        case GGML_TYPE_IQ2_S:   return dequantize_k_ld_cuda<32, dequantize_iq2_s<float>>;
+        case GGML_TYPE_IQ3_XXS: return dequantize_k_ld_cuda<32, dequantize_iq3_xxs<float>>;
+        case GGML_TYPE_IQ3_S:   return dequantize_k_ld_cuda<32, dequantize_iq3_s<float>>;
+        case GGML_TYPE_IQ1_S:   return dequantize_k_ld_cuda<32, dequantize_iq1_s<float>>;
+        case GGML_TYPE_IQ1_M:   return dequantize_k_ld_cuda<32, dequantize_iq1_m<float>>;
+        case GGML_TYPE_IQ4_NL:  return dequantize_k_ld_cuda<32, dequantize_iq4_nl<float>>;
+        case GGML_TYPE_IQ4_XS:  return dequantize_k_ld_cuda<32, dequantize_iq4_xs<float>>;
+        default:                return nullptr;
+    }
+}
