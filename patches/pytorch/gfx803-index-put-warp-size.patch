 #include <c10/core/QScheme.h>
 #include <ATen/native/quantized/AffineQuantizerBase.h>
 
+#include <cstring>
 #include <limits>
 
 #include <c10/macros/Macros.h>
 
 namespace {
+// The index_put kernels below index in warps of C10_WARP_SIZE lanes, which is 32 in device code for
+// every AMD target except gfx9, while at::cuda::warp_size() is the hardware's 64 on gfx6-8. Sizing
+// their launches by the hardware value there leaves half of each block's indices unvisited and makes
+// lanes 32-63 repeat lanes 0-31, so accumulated sums come out wrong. Launch with the compiled
+// width; on 64-lane hardware each half-wavefront then runs as one of the kernels' warps.
+// GFX803_INDEX_PUT_WARP_SIZE_PATCH
+int index_put_warp_size() {
+#ifdef USE_ROCM
+  const auto* prop = at::cuda::getCurrentDeviceProperties();
+  if (prop->warpSize == 64 && std::strncmp(prop->gcnArchName, "gfx9", 4) != 0) {
+    return 32;
+  }
+#endif
+  return at::cuda::warp_size();
+}
