+// GFX803_LAYER_NORM_WARP_SIZE_PATCH: the kernels below reduce over
+// C10_WARP_SIZE lanes, which c10/macros/Macros.h makes 64 only for gfx9 and 32
+// for every other AMD target, while at::cuda::warp_size() reports the
+// hardware's wavefront, 64 on gfx6-8. Sized by the hardware value, blocks and
+// shared memory fit half as many warps as the device code reduces over: the
+// vectorized forward kernel leaves lanes 32-63 of each wavefront out of the row
+// statistics, and the backward kernel's BlockReduceSum writes past its shared
+// buffer. Launches here use the warp size the device code was compiled with.
+int layer_norm_warp_size() {
+#ifdef USE_ROCM
+  const auto* prop = at::cuda::getCurrentDeviceProperties();
+  if (prop->warpSize == 64 && std::strncmp(prop->gcnArchName, "gfx9", 4) != 0) {
+    return 32;
+  }
+#endif
+  return at::cuda::warp_size();
+}
